{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsv-blockchain.github.io/dpp/contracts/capabilities.schema.json",
  "title": "DPP capability document, version 1",
  "description": "What one implementation declares it supports (spec/conformance.md section 4): roles, protocol versions, exact profiles with artefact digests, representations, proof suites, anchor formats, topics and services, limits, and what it explicitly does not support. A claim of support, checkable against the ledger; never proof of authority or conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilitiesVersion", "implementation", "roles", "protocols", "profiles", "representations", "proofSuites", "anchorFormats", "unsupported"],
  "properties": {
    "capabilitiesVersion": { "const": "1" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "baselineId": { "type": "string", "description": "The recommended baseline claimed, for example native-baseline@1." }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["passport-reader", "attestation-verifier", "passport-writer", "attestation-issuer", "registry", "overlay"] }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "For example dpp-record, dpp-lifecycle, bsv-attestation-anchor, overlay-http, registry-http, verification-report." },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["industry", "exchange", "operator", "custody"] },
          "artefactDigests": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "description": "SHA-256 per artefact path or identifier the profile publishes."
          },
          "options": { "type": "object", "additionalProperties": true, "description": "The named options selected under the profile, for example ownerConsent or transferAuthorities." }
        }
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mediaType", "verification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "verification": { "enum": ["content", "commitment-only"], "description": "content: the representation's own rules are implemented; commitment-only: anchors are indexed and content verification returns unsupported." }
        }
      }
    },
    "proofSuites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "anchorFormats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "status"],
        "properties": {
          "prefix": { "type": "string", "minLength": 1 },
          "status": { "enum": ["current", "historical", "refused"] }
        }
      }
    },
    "topics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "services": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "publisherPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "How an overlay or registry authorises publishers and anchoring services, separately from its own identity.",
      "properties": {
        "policyVersion": { "type": "string" },
        "publisherKeys": { "type": "array", "items": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" } },
        "anchoringServices": { "type": "array", "items": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" } },
        "ownerConsent": { "enum": ["not-selected", "required"] },
        "transferAuthorities": { "type": "array", "items": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" } }
      }
    },
    "synchronisation": {
      "type": "object",
      "additionalProperties": false,
      "description": "The operator profile actually configured, so a client knows whether a second operator can be expected to hold the same evidence.",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "description": "For example single-operator@1 or federated-operators@1." },
        "discovery": { "enum": ["none", "ship-slap", "static-peers"] },
        "gasp": { "type": "boolean" },
        "peers": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "string"] },
      "description": "Named service limits, for example maxLookupResults, defaultPageSize, maxBodyBytes, statusFetchTimeoutMs."
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
