{
  "name": "@bsv/dpp-overlay-topics",
  "version": "0.4.0-beta.11",
  "description": "Experimental prerelease: DPP overlay index components, a supported HTTP host and dpp-index executable, with passport and attestation topics, persistent storage, evidence export and peer synchronisation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "dpp-index": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@bsv/dpp-protocol": "0.3.0-beta.9",
    "@bsv/dpp-profiles": "0.3.0-beta.9",
    "@bsv/overlay": "2.3.1",
    "@bsv/sdk": "2.8.10",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/dpp.git",
    "directory": "packages/overlay-topics"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@bsv/wallet-toolbox-client": "2.11.0"
  }
}
