{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsv:dpp:profile:battery@3:payload-public",
  "title": "Battery passport (battery@3), public payload",
  "description": "battery@3: the public payload carried on chain in field 10. JSON Schema validity is one check; obligation under a condition (needs-review), units, provenance and legal applicability are separate checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "notice": {
      "type": "string",
      "minLength": 1,
      "description": "The sample marker a demonstration record carries first; never product data."
    },
    "profile": {
      "const": "battery",
      "description": "The profile identifier the payload declares."
    },
    "profile_version": {
      "const": 3,
      "description": "The profile version the payload declares; a reader decodes under it and never under a newer one."
    },
    "object_did": {
      "type": "string",
      "minLength": 1,
      "description": "An optional physical-object DID carried in the public payload; carrying it does not implement physical binding."
    },
    "dataCarrier": {
      "type": "string",
      "minLength": 1,
      "description": "The data-carrier identifier (chip UID) the lookup service indexes beside the passport identifier."
    },
    "passportId": {
      "type": "string",
      "minLength": 1,
      "title": "Passport reference",
      "description": "required; Art. 77(3)"
    },
    "serial": {
      "type": "string",
      "minLength": 1,
      "title": "Serial number",
      "description": "required; Annex XIII (1a); Art. 38(6); Art. 77(3)"
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Model name",
      "description": "required; Annex VI Part A(2)"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "title": "Responsible operator",
      "description": "required; Art. 77(3)"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1,
      "title": "Brand name",
      "description": "required; Annex VI Part A(1); Art. 38(7)"
    },
    "manufacturerContact": {
      "type": "string",
      "minLength": 1,
      "title": "Brand contact",
      "description": "required; Annex VI Part A(1)"
    },
    "manufacturingPlace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "country"
      ],
      "title": "Place of manufacture",
      "description": "required; Annex VI Part A(3)"
    },
    "manufacturingDate": {
      "type": "string",
      "format": "date",
      "title": "Made",
      "description": "required; Annex VI Part A(4)"
    },
    "warrantyUntil": {
      "type": "string",
      "format": "date",
      "title": "Guarantee until",
      "description": "required; Annex XIII (1m); applicability unresolved"
    },
    "category": {
      "enum": [
        "lmt",
        "ev",
        "industrial",
        "stationary"
      ],
      "title": "Category",
      "description": "required; Annex VI Part A(2); Art. 3"
    },
    "massKg": {
      "type": "number",
      "minimum": 0,
      "title": "Mass",
      "description": "required; Annex VI Part A(5)"
    },
    "separateCollectionSymbol": {
      "type": "string",
      "minLength": 1,
      "title": "Separate collection symbol",
      "description": "required; Art. 13(4); Annex VI Part B; Annex XIII (1q)"
    },
    "elementSymbols": {
      "type": "string",
      "minLength": 1,
      "title": "Element symbols",
      "description": "required; Art. 13(5); Art. 74(1e); Annex XIII (1s); applicability needs-review"
    },
    "carbonFootprintLabel": {
      "type": "string",
      "title": "Carbon footprint label",
      "description": "required; Art. 7(2); Annex XIII (1c)"
    },
    "extinguishingAgent": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "title": "Usable extinguishing agent",
      "description": "required; Annex VI Part A(9)"
    },
    "labelMeaning": {
      "type": "string",
      "minLength": 1,
      "title": "What the symbols mean",
      "description": "required; Art. 74(1e); Annex XIII (1s)"
    },
    "declarationOfConformity": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Declaration of conformity",
      "description": "required; Art. 18; Annex XIII (1r)"
    },
    "carbonFootprint": {
      "type": "string",
      "title": "Declared footprint",
      "description": "required; Art. 7(1); Annex XIII"
    },
    "carbonRawMaterials": {
      "type": "string",
      "title": "Footprint: raw materials",
      "description": "required; Art. 7(1)"
    },
    "carbonProduction": {
      "type": "string",
      "title": "Footprint: production",
      "description": "required; Art. 7(1)"
    },
    "carbonDistribution": {
      "type": "string",
      "title": "Footprint: distribution",
      "description": "required; Art. 7(1)"
    },
    "carbonEndOfLife": {
      "type": "string",
      "title": "Footprint: end of life",
      "description": "required; Art. 7(1)"
    },
    "carbonClass": {
      "type": "string",
      "title": "Carbon class",
      "description": "required; Art. 7(2); Annex XIII (1c)"
    },
    "carbonStudyUrl": {
      "type": "string",
      "title": "Footprint study",
      "description": "required; Art. 7(1)"
    },
    "carbonGeneralInfo": {
      "type": "string",
      "title": "Battery and brand information",
      "description": "required; Art. 7(1)"
    },
    "carbonAbsolute": {
      "type": "string",
      "title": "Total footprint",
      "description": "recommended; none (spec recommendation)"
    },
    "dueDiligenceReport": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Due diligence report",
      "description": "required; Annex XIII (1d); Art. 52(3)"
    },
    "dueDiligenceAssurances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scheme": {
            "type": "string",
            "minLength": 1
          },
          "assurer": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scheme",
          "assurer"
        ]
      },
      "title": "Third-party assurance",
      "description": "recommended; Art. 53"
    },
    "supplyChainIndices": {
      "type": "string",
      "minLength": 1,
      "title": "Supply chain indices",
      "description": "recommended; none (spec recommendation)"
    },
    "chemistry": {
      "type": "string",
      "minLength": 1,
      "title": "Chemistry",
      "description": "required; Annex XIII (1b)"
    },
    "criticalRawMaterials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "aluminium",
          "antimony",
          "arsenic",
          "baryte",
          "beryllium",
          "bismuth",
          "boron",
          "cobalt",
          "coking-coal",
          "copper",
          "feldspar",
          "fluorspar",
          "gallium",
          "germanium",
          "hafnium",
          "helium",
          "heavy-ree",
          "light-ree",
          "lithium",
          "magnesium",
          "manganese",
          "natural-graphite",
          "nickel",
          "niobium",
          "pgm",
          "phosphate-rock",
          "phosphorus",
          "scandium",
          "silicon-metal",
          "strontium",
          "tantalum",
          "titanium-metal",
          "tungsten",
          "vanadium"
        ]
      },
      "title": "Critical raw materials",
      "description": "required; Annex XIII (1b); Annex VI Part A(10)"
    },
    "hazardousSubstances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cas": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{2,7}-\\d{2}-\\d$"
          },
          "concentration": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "cas"
        ]
      },
      "title": "Hazardous substances",
      "description": "required; Annex XIII (1b); Annex VI Part A(8)"
    },
    "substanceImpact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "title": "Effects of those substances",
      "description": "required; Art. 74(1f)"
    },
    "recycledShareTotal": {
      "type": "string",
      "title": "Recycled content",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledNickelPre": {
      "type": "string",
      "title": "Nickel, pre-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledCobaltPre": {
      "type": "string",
      "title": "Cobalt, pre-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledLithiumPre": {
      "type": "string",
      "title": "Lithium, pre-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledLeadPre": {
      "type": "string",
      "title": "Lead, pre-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledNickelPost": {
      "type": "string",
      "title": "Nickel, post-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledCobaltPost": {
      "type": "string",
      "title": "Cobalt, post-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledLithiumPost": {
      "type": "string",
      "title": "Lithium, post-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "recycledLeadPost": {
      "type": "string",
      "title": "Lead, post-consumer",
      "description": "required; Annex XIII (1e); Art. 8(1)"
    },
    "renewableShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Renewable content",
      "description": "required; Annex XIII (1f)"
    },
    "endUserWastePrevention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Making it last",
      "description": "required; Annex XIII (1s); Art. 74(1a)"
    },
    "endUserCollection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Where to return it",
      "description": "required; Annex XIII (1s); Art. 74"
    },
    "endOfLifeTreatment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "End of life",
      "description": "required; Annex XIII (1s); Art. 74"
    },
    "ratedCapacityAh": {
      "type": "number",
      "minimum": 0,
      "title": "Rated capacity",
      "description": "required; Annex IV Part A(1); Annex VI Part A(6)"
    },
    "voltageMin": {
      "type": "number",
      "minimum": 0,
      "title": "Minimum voltage",
      "description": "required; Annex XIII (1h)"
    },
    "voltageMax": {
      "type": "number",
      "minimum": 0,
      "title": "Maximum voltage",
      "description": "required; Annex XIII (1h)"
    },
    "voltageNominal": {
      "type": "number",
      "minimum": 0,
      "title": "Nominal voltage",
      "description": "required; Annex XIII (1h)"
    },
    "powerOriginal": {
      "type": "integer",
      "minimum": 0,
      "title": "Original power",
      "description": "required; Annex XIII (1i)"
    },
    "powerMax": {
      "type": "integer",
      "minimum": 0,
      "title": "Maximum permitted power",
      "description": "required; Annex XIII (1i)"
    },
    "roundTripInitial": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Round trip efficiency, initial",
      "description": "required; Annex XIII (1n); applicability any"
    },
    "roundTripAtHalfLife": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Round trip efficiency at half life",
      "description": "required; Annex XIII (1n); applicability any"
    },
    "resistancePack": {
      "type": "number",
      "minimum": 0,
      "title": "Internal resistance, pack",
      "description": "required; Annex XIII (1o)"
    },
    "resistanceCell": {
      "type": "number",
      "minimum": 0,
      "title": "Internal resistance, cell",
      "description": "required; Annex XIII (1o)"
    },
    "resistanceModule": {
      "type": "number",
      "minimum": 0,
      "title": "Internal resistance, module",
      "description": "recommended; Annex XIII (1o)"
    },
    "expectedCycles": {
      "type": "integer",
      "minimum": 0,
      "title": "Expected life in cycles",
      "description": "required; Annex XIII (1j); applicability any"
    },
    "cycleLifeTest": {
      "type": "string",
      "minLength": 1,
      "title": "Cycle life test used",
      "description": "required; Annex XIII (1j); applicability any"
    },
    "cRate": {
      "type": "number",
      "minimum": 0,
      "title": "C-rate of that test",
      "description": "required; Annex XIII (1p); applicability any"
    },
    "exhaustionThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Exhaustion threshold",
      "description": "required; Annex XIII (1k); applicability category-in"
    },
    "idleTempLower": {
      "type": "integer",
      "minimum": -60,
      "maximum": 150,
      "title": "Idle temperature, lowest",
      "description": "required; Annex XIII (1l)"
    },
    "idleTempUpper": {
      "type": "integer",
      "minimum": -60,
      "maximum": 150,
      "title": "Idle temperature, highest",
      "description": "required; Annex XIII (1l)"
    },
    "safety": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Safety",
      "description": "recommended; app addition; the spec puts safety measures at 6.6.1.5, restricted"
    },
    "manufacturerAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "postalCode": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "city",
        "country"
      ],
      "title": "Manufacturer postal address",
      "description": "required; Annex VI Part A(1): the postal address of the manufacturer, indicating a single contact point"
    },
    "manufacturerWeb": {
      "type": "string",
      "format": "uri",
      "title": "Manufacturer web address",
      "description": "optional; Annex VI Part A(1): web address, if available"
    },
    "manufacturerEmail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254,
      "title": "Manufacturer email address",
      "description": "optional; Annex VI Part A(1): email address, if available"
    },
    "manufacturingMonth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "title": "Month of manufacture",
      "description": "optional; Annex VI Part A(4): the date of manufacturing as month and year"
    },
    "warrantyTerms": {
      "$ref": "#/$defs/warrantyTerms",
      "title": "Commercial warranty terms",
      "description": "optional; Annex XIII 1 (m): the period for which the commercial warranty for the calendar life applies; applicability unresolved"
    },
    "operatingTemperatureRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lower": {
          "type": "integer"
        },
        "upper": {
          "type": "integer"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "Operating temperature range",
      "description": "optional; Annex XIII 1 (h) and (i): the temperature range that qualifies the voltage and power values when relevant"
    },
    "instructionsForUse": {
      "type": "string",
      "title": "Instructions for use",
      "description": "recommended; Annex XIII 1 (t): clear, understandable and readable instructions for use in a format that can be printed, downloaded and saved"
    },
    "inapplicableFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "declaredBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "reason"
        ]
      },
      "title": "Declared inapplicable fields",
      "description": "optional; none: the profile's own declaration by which a record says that a conditional data point does not apply to it, with the reason"
    }
  },
  "required": [
    "category",
    "chemistry",
    "criticalRawMaterials",
    "endOfLifeTreatment",
    "endUserCollection",
    "endUserWastePrevention",
    "extinguishingAgent",
    "hazardousSubstances",
    "idleTempLower",
    "idleTempUpper",
    "labelMeaning",
    "manufacturer",
    "manufacturerAddress",
    "manufacturerContact",
    "manufacturingDate",
    "manufacturingPlace",
    "massKg",
    "modelName",
    "operator",
    "passportId",
    "powerMax",
    "powerOriginal",
    "profile",
    "profile_version",
    "ratedCapacityAh",
    "renewableShare",
    "resistanceCell",
    "resistancePack",
    "separateCollectionSymbol",
    "serial",
    "substanceImpact",
    "voltageMax",
    "voltageMin",
    "voltageNominal"
  ],
  "$defs": {
    "datePrecision": {
      "enum": [
        "day",
        "month",
        "year"
      ],
      "description": "How precise a date is. A month-precision date is written YYYY-MM and never given a day; a year-precision date is written YYYY."
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dayDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "monthDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "yearDate": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "dateOrDateTime": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01])(T\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?(Z|[+-]\\d{2}:\\d{2}))?)?)?$",
      "description": "A year, a month, a day or an instant; the precision the shape declares says which is meant."
    },
    "preciseDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "precision"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "day"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/dayDate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "month"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/monthDate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "year"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/yearDate"
              }
            }
          }
        }
      ]
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "granularity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "granularity": {
          "enum": [
            "model",
            "batch",
            "item",
            "component"
          ]
        },
        "componentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "The component this evidence covers, when the granularity is component; a component need not have a token."
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-revision",
            "credential",
            "document"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "relevantTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "from": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "until": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        }
      }
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "subject",
        "source"
      ],
      "properties": {
        "property": {
          "type": "string",
          "pattern": "^/",
          "description": "The JSON pointer of the field the evidence is about."
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "reporter": {
          "type": "string",
          "minLength": 1,
          "description": "Who reported the fact, when that is not the issuer of the source."
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "relevantTime": {
          "$ref": "#/$defs/relevantTime"
        },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "description": "A verification report the evidence was evaluated in."
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "certificateId",
        "issuer",
        "subject",
        "verification"
      ],
      "description": "A certificate as evidence. The scheme's homepage and the issuer's signature are inputs to a verification; only verification.status says what was established, and unknown is not a pass.",
      "properties": {
        "scheme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "certificateId": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "description": "The certification body or issuer as named on the certificate."
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "validFrom": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "validUntil": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        },
        "documentRef": {
          "$ref": "#/$defs/relatedDocument"
        },
        "credentialRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/hex64"
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "failed",
                "unknown",
                "not-checked"
              ]
            },
            "checkedAt": {
              "$ref": "#/$defs/dateOrDateTime"
            },
            "reportRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "value",
        "unit",
        "subject"
      ],
      "description": "A measured or assessed value with the scope that makes it comparable: the unit, the basis (a fraction is not a percent), the functional unit or denominator, the method and its version, the boundary and conditions, when it was measured and for which subject. A value that is a string carries a basis, because a bare string cannot be compared.",
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "$ref": "#/$defs/measurementBasis"
        },
        "functionalUnit": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "$ref": "#/$defs/quantity"
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "measuredAt": {
          "$ref": "#/$defs/preciseDate"
        },
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/dateOrDateTime"
            },
            "until": {
              "$ref": "#/$defs/dateOrDateTime"
            }
          }
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimEvidence"
          }
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromUnit",
            "toUnit",
            "rule",
            "explicit"
          ],
          "description": "Present only when the value was converted from its source unit under a stated rule; a converted value never loses its source unit.",
          "properties": {
            "fromUnit": {
              "type": "string",
              "minLength": 1
            },
            "toUnit": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "explicit": {
              "const": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "$ref": "#/$defs/measurementBasis"
              }
            },
            "required": [
              "basis"
            ]
          }
        }
      ]
    },
    "relatedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "purpose",
        "retained",
        "access"
      ],
      "description": "A document a value points at. A URL is where the document was seen, not a commitment to its content; only retained bytes carry a digest.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "revision": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        },
        "digest": {
          "$ref": "#/$defs/hex64"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "retained": {
          "type": "boolean"
        },
        "access": {
          "enum": [
            "public",
            "owner",
            "legitimate",
            "authority"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retained": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "digest": {
                "$ref": "#/$defs/hex64"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "digest",
              "byteLength"
            ]
          }
        }
      ]
    },
    "localisedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "description": "Text in one or more languages as the source supplied it. A reader selects the exact tag, then the base language, then the declared default, and records which; it never rewrites a value as another language.",
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "text"
            ],
            "properties": {
              "language": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "returnedLanguage": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "selection": {
          "enum": [
            "exact",
            "base",
            "default"
          ]
        }
      }
    },
    "warrantyTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "calendarRule"
      ],
      "description": "A model's warranty terms: a duration and the calendar rule that says what the duration counts from. Terms alone give no expiry.",
      "properties": {
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "enum": [
                "months",
                "years"
              ]
            }
          }
        },
        "calendarRule": {
          "enum": [
            "purchase-date",
            "manufacture-date",
            "first-use"
          ]
        },
        "conditions": {
          "type": "string"
        }
      }
    },
    "warrantyExpiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "terms",
        "derived"
      ],
      "description": "An item's derived warranty expiry: the evidenced start, the terms applied and the derived date at the precision the start permits. A month-precision start yields a month, never an invented day.",
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "precision",
            "evidenceRef"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "precision": {
              "$ref": "#/$defs/datePrecision"
            },
            "evidenceRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "terms": {
          "$ref": "#/$defs/warrantyTerms"
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "precision",
            "rule"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "precision": {
              "$ref": "#/$defs/datePrecision"
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "measurementBasis": {
      "enum": [
        "fraction",
        "percent",
        "mass",
        "count",
        "per-functional-unit"
      ]
    }
  }
}
