{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsv:dpp:profile:battery@3:payload-restricted",
  "title": "Battery passport (battery@3), restricted payload",
  "description": "battery@3: the restricted tiers held off chain, encrypted, and committed by field 11. JSON Schema validity is one check; obligation under a condition (needs-review), units, provenance and legal applicability are separate checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "serviceDate": {
      "type": "string",
      "format": "date",
      "title": "Put into service",
      "description": "required; Annex XIII (4); applicability category-in"
    },
    "status": {
      "enum": [
        "Original",
        "Reused",
        "Repurposed",
        "Remanufactured",
        "Waste"
      ],
      "title": "Status",
      "description": "required; Annex XIII 4(c); Art. 77(7)"
    },
    "testReports": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Test reports",
      "description": "required; Annex XIII (3)"
    },
    "electrodeMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component": {
            "enum": [
              "cathode",
              "anode",
              "electrolyte",
              "separator",
              "casing"
            ]
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "component",
          "material"
        ]
      },
      "title": "Cathode, anode and electrolyte materials",
      "description": "required; Annex XIII (2a)"
    },
    "dismantlingManual": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Dismantling manual",
      "description": "required; Annex XIII (2c)"
    },
    "partNumbersUrl": {
      "type": "string",
      "format": "uri",
      "title": "Part numbers",
      "description": "required; Annex XIII (2b)"
    },
    "sparePartsAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "locality": {
          "type": "string",
          "minLength": 1
        },
        "postcode": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "street",
        "locality",
        "country"
      ],
      "title": "Spare parts: postal address",
      "description": "required; Annex XIII (2b)"
    },
    "sparePartsEmail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$",
      "title": "Spare parts: e-mail",
      "description": "required; Annex XIII (2b)"
    },
    "sparePartsUrl": {
      "type": "string",
      "format": "uri",
      "title": "Spare parts: web address",
      "description": "required; Annex XIII (2b)"
    },
    "safetyMeasures": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Safety measures",
      "description": "required; Annex XIII (2d)"
    },
    "remainingCapacityAh": {
      "type": "number",
      "minimum": 0,
      "title": "Remaining capacity",
      "description": "required; Annex VII Part A(1); applicability any"
    },
    "capacityFade": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Capacity fade",
      "description": "required; Annex IV Part A(1); applicability any"
    },
    "certifiedEnergyKwh": {
      "type": "number",
      "minimum": 0,
      "title": "Usable energy",
      "description": "recommended; added by the consortium, based on UN GTR No 22; applicability category-in"
    },
    "remainingEnergyKwh": {
      "type": "number",
      "minimum": 0,
      "title": "Remaining usable energy",
      "description": "recommended; added by the consortium, based on UN GTR No 22; applicability category-in"
    },
    "soce": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "State of certified energy",
      "description": "required; UN GTR No 22; applicability category-in"
    },
    "stateOfCharge": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "State of charge",
      "description": "required; Annex XIII 4(d); applicability unresolved"
    },
    "powerRemaining": {
      "type": "integer",
      "minimum": 0,
      "title": "Remaining power",
      "description": "required; Annex VII Part A(2); Annex IV; applicability any"
    },
    "powerFade": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Power fade",
      "description": "required; Annex IV Part A(2); applicability any"
    },
    "powerToEnergy": {
      "type": "number",
      "minimum": 0,
      "title": "Power to energy ratio",
      "description": "recommended; Annex IV Part B(2)"
    },
    "roundTripRemaining": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Round trip efficiency, remaining",
      "description": "required; Annex VII Part A(3); applicability any"
    },
    "roundTripFade": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Round trip efficiency fade",
      "description": "required; Annex IV Part A(4); applicability unresolved"
    },
    "selfDischargeInitial": {
      "type": "number",
      "minimum": 0,
      "title": "Self-discharge, initial",
      "description": "recommended; Annex VII Part A(4); applicability category-in"
    },
    "selfDischargeCurrent": {
      "type": "number",
      "minimum": 0,
      "title": "Self-discharge, current",
      "description": "recommended; Annex VII Part A(4); applicability any"
    },
    "selfDischargeEvolution": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Self-discharge over time",
      "description": "required; Annex VII Part A(4); applicability any"
    },
    "resistanceIncreasePack": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Resistance increase, pack",
      "description": "required; Annex IV Part A(3); applicability any"
    },
    "resistanceIncreaseCell": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Resistance increase, cell",
      "description": "recommended; Annex IV Part A(3)"
    },
    "resistanceIncreaseModule": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Resistance increase, module",
      "description": "recommended; Annex IV Part A(3)"
    },
    "expectedYears": {
      "type": "number",
      "minimum": 0,
      "title": "Expected life in years",
      "description": "required; Annex IV Part A(5); applicability any"
    },
    "cyclesUsed": {
      "type": "integer",
      "minimum": 0,
      "title": "Cycles so far",
      "description": "required; Annex XIII (4d); applicability unresolved"
    },
    "energyThroughput": {
      "type": "number",
      "minimum": 0,
      "title": "Energy through the battery",
      "description": "required; Annex VII Part B(2); applicability category-in"
    },
    "capacityThroughput": {
      "type": "number",
      "minimum": 0,
      "title": "Capacity through the battery",
      "description": "required; Annex VII Part B(3); applicability category-in"
    },
    "temperatureRecord": {
      "type": "number",
      "minimum": -60,
      "maximum": 150,
      "title": "Temperature record",
      "description": "required; Annex XIII (4d); applicability unresolved"
    },
    "timeAboveRange": {
      "type": "number",
      "minimum": 0,
      "title": "Time above range",
      "description": "required; Annex VII Part B(4); applicability unresolved"
    },
    "timeBelowRange": {
      "type": "number",
      "minimum": 0,
      "title": "Time below range",
      "description": "required; Annex VII Part B(4); applicability unresolved"
    },
    "chargingAboveRange": {
      "type": "number",
      "minimum": 0,
      "title": "Charging above range",
      "description": "required; Annex VII Part B(4); applicability unresolved"
    },
    "chargingBelowRange": {
      "type": "number",
      "minimum": 0,
      "title": "Charging below range",
      "description": "required; Annex VII Part B(4); applicability unresolved"
    },
    "deepDischargeEvents": {
      "type": "integer",
      "minimum": 0,
      "title": "Deep discharges",
      "description": "required; Annex VII; applicability unresolved"
    },
    "overchargeEvents": {
      "type": "integer",
      "minimum": 0,
      "title": "Overcharges",
      "description": "recommended; added by the consortium"
    },
    "accidents": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ],
      "title": "Accidents",
      "description": "required; Annex XIII (4d); applicability unresolved"
    },
    "stateOfHealth": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "State of health",
      "description": "recommended; app addition; the spec decomposes SoH into Annex VII Part A parameters"
    },
    "measured": {
      "enum": [
        "manufacturer",
        "authorised-service",
        "independent-lab",
        "operator",
        "repurposer",
        "recycler"
      ],
      "title": "Measured by",
      "description": "recommended; app addition"
    },
    "ratedCapacityCurrentAh": {
      "$ref": "#/$defs/measurement",
      "title": "Rated capacity, current",
      "description": "required; Annex XIII 4 (a): the rated capacity as a dynamic value after a change of status; applicability any"
    },
    "resistanceCurrentOhm": {
      "$ref": "#/$defs/measurement",
      "title": "Internal resistance, current",
      "description": "required; Annex XIII 4 (b); Art. 14: the ohmic resistance as state of health information, where possible; applicability any"
    },
    "temperatureSeries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      },
      "title": "Temperature, periodically recorded",
      "description": "required; Annex XIII 4 (d): periodically recorded information on the operating environmental conditions, including temperature; applicability unresolved"
    },
    "stateOfChargeSeries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      },
      "title": "State of charge, periodically recorded",
      "description": "required; Annex XIII 4 (d): periodically recorded information on the state of charge; applicability unresolved"
    }
  },
  "required": [
    "dismantlingManual",
    "electrodeMaterials",
    "partNumbersUrl",
    "safetyMeasures",
    "sparePartsAddress",
    "sparePartsEmail",
    "sparePartsUrl"
  ],
  "$defs": {
    "datePrecision": {
      "enum": [
        "day",
        "month",
        "year"
      ],
      "description": "How precise a date is. A month-precision date is written YYYY-MM and never given a day; a year-precision date is written YYYY."
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dayDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "monthDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "yearDate": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "dateOrDateTime": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01])(T\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?(Z|[+-]\\d{2}:\\d{2}))?)?)?$",
      "description": "A year, a month, a day or an instant; the precision the shape declares says which is meant."
    },
    "preciseDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "precision"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "day"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/dayDate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "month"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/monthDate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "year"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/yearDate"
              }
            }
          }
        }
      ]
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "granularity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "granularity": {
          "enum": [
            "model",
            "batch",
            "item",
            "component"
          ]
        },
        "componentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "The component this evidence covers, when the granularity is component; a component need not have a token."
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-revision",
            "credential",
            "document"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "relevantTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "from": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "until": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        }
      }
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "subject",
        "source"
      ],
      "properties": {
        "property": {
          "type": "string",
          "pattern": "^/",
          "description": "The JSON pointer of the field the evidence is about."
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "reporter": {
          "type": "string",
          "minLength": 1,
          "description": "Who reported the fact, when that is not the issuer of the source."
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "relevantTime": {
          "$ref": "#/$defs/relevantTime"
        },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "description": "A verification report the evidence was evaluated in."
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "certificateId",
        "issuer",
        "subject",
        "verification"
      ],
      "description": "A certificate as evidence. The scheme's homepage and the issuer's signature are inputs to a verification; only verification.status says what was established, and unknown is not a pass.",
      "properties": {
        "scheme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "certificateId": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "description": "The certification body or issuer as named on the certificate."
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "validFrom": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "validUntil": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        },
        "documentRef": {
          "$ref": "#/$defs/relatedDocument"
        },
        "credentialRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/hex64"
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "failed",
                "unknown",
                "not-checked"
              ]
            },
            "checkedAt": {
              "$ref": "#/$defs/dateOrDateTime"
            },
            "reportRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "value",
        "unit",
        "subject"
      ],
      "description": "A measured or assessed value with the scope that makes it comparable: the unit, the basis (a fraction is not a percent), the functional unit or denominator, the method and its version, the boundary and conditions, when it was measured and for which subject. A value that is a string carries a basis, because a bare string cannot be compared.",
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "$ref": "#/$defs/measurementBasis"
        },
        "functionalUnit": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "$ref": "#/$defs/quantity"
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "measuredAt": {
          "$ref": "#/$defs/preciseDate"
        },
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/dateOrDateTime"
            },
            "until": {
              "$ref": "#/$defs/dateOrDateTime"
            }
          }
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimEvidence"
          }
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromUnit",
            "toUnit",
            "rule",
            "explicit"
          ],
          "description": "Present only when the value was converted from its source unit under a stated rule; a converted value never loses its source unit.",
          "properties": {
            "fromUnit": {
              "type": "string",
              "minLength": 1
            },
            "toUnit": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "explicit": {
              "const": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "$ref": "#/$defs/measurementBasis"
              }
            },
            "required": [
              "basis"
            ]
          }
        }
      ]
    },
    "relatedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "purpose",
        "retained",
        "access"
      ],
      "description": "A document a value points at. A URL is where the document was seen, not a commitment to its content; only retained bytes carry a digest.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "revision": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/dateOrDateTime"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        },
        "digest": {
          "$ref": "#/$defs/hex64"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "retained": {
          "type": "boolean"
        },
        "access": {
          "enum": [
            "public",
            "owner",
            "legitimate",
            "authority"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retained": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "digest": {
                "$ref": "#/$defs/hex64"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "digest",
              "byteLength"
            ]
          }
        }
      ]
    },
    "localisedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "description": "Text in one or more languages as the source supplied it. A reader selects the exact tag, then the base language, then the declared default, and records which; it never rewrites a value as another language.",
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "text"
            ],
            "properties": {
              "language": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "returnedLanguage": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "selection": {
          "enum": [
            "exact",
            "base",
            "default"
          ]
        }
      }
    },
    "warrantyTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "calendarRule"
      ],
      "description": "A model's warranty terms: a duration and the calendar rule that says what the duration counts from. Terms alone give no expiry.",
      "properties": {
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "enum": [
                "months",
                "years"
              ]
            }
          }
        },
        "calendarRule": {
          "enum": [
            "purchase-date",
            "manufacture-date",
            "first-use"
          ]
        },
        "conditions": {
          "type": "string"
        }
      }
    },
    "warrantyExpiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "terms",
        "derived"
      ],
      "description": "An item's derived warranty expiry: the evidenced start, the terms applied and the derived date at the precision the start permits. A month-precision start yields a month, never an invented day.",
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "precision",
            "evidenceRef"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "precision": {
              "$ref": "#/$defs/datePrecision"
            },
            "evidenceRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "terms": {
          "$ref": "#/$defs/warrantyTerms"
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "precision",
            "rule"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "precision": {
              "$ref": "#/$defs/datePrecision"
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "measurementBasis": {
      "enum": [
        "fraction",
        "percent",
        "mass",
        "count",
        "per-functional-unit"
      ]
    }
  }
}
