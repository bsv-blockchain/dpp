{
  "name": "@bsv/dpp-profiles",
  "version": "0.3.0-beta.10",
  "description": "Experimental prerelease: Canonical DPP industry, exchange, operator and interoperability profiles: immutable manifests, generated payload schemas and consumer documents, lifecycle mapping, GS1 identifier and discovery helpers, applicability evaluation and deterministic passport projection",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dpp-validator": "./dist/validator-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation-engine": {
      "types": "./dist/validation-engine.d.ts",
      "default": "./dist/validation-engine.js"
    },
    "./validator-client": {
      "types": "./dist/validator-client.d.ts",
      "default": "./dist/validator-client.js"
    },
    "./validator-service": {
      "types": "./dist/validator-service.d.ts",
      "default": "./dist/validator-service.js"
    },
    "./manifests/*": "./manifests/*",
    "./schemas/*": "./schemas/*",
    "./generated/*": "./generated/*",
    "./frozen.json": "./frozen.json"
  },
  "files": [
    "PATENTS",
    "NOTICE",
    "dist",
    "manifests",
    "schemas",
    "generated",
    "bindings",
    "frozen.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"const fs=require('fs');for(const f of ['NOTICE','PATENTS'])fs.copyFileSync('../../'+f,f)\"",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "generate": "node scripts/build.mjs",
    "changes": "node scripts/profile-changes.mjs",
    "refreeze": "node scripts/build.mjs --refreeze",
    "freeze-new": "node scripts/build.mjs --freeze-new",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "@bsv/dpp-protocol": "0.3.0-beta.10",
    "@bsv/sdk": "4.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "@types/node": "26.6.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/dpp.git",
    "directory": "packages/dpp-profiles"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
