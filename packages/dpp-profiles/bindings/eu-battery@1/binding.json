  "validation": {
    "steps": [
      "json-ld-expand",
      "shacl",
      "passport-identity"
    ],
    "engine": {
      "requires": [
        "shacl-core",
        "shacl-sparql-constraints"
      ]
    },
    "blockingSeverities": [
      "Violation"
    ]
  },
  "identity": {
    "scheme": "gs1-digital-link",
    "comparison": "gs1-key-tuple",
    "subject": {
      "pointers": [
        "/product/id",
        "/product/@id"
      ],
      "keys": [
        "01",
        "21"
      ]
    },
    "mustEqual": [
      {
        "pointer": "/product/gs1:gtin",
        "part": "gtin"
      },
      {
        "pointer": "/product/gs1:hasSerialNumber",
        "part": "serial"
      },
      {
        "pointer": "/product/schema:serialNumber",
        "part": "serial"
      }
    ],
    "mustNotContradict": [
      {
        "pointer": "/product/oec:passportIdentifier"
      },
      {
        "pointer": "/product/gs1:productID"
      }
    ],
    "granularityMember": {
      "pointer": "/product/oec:granularityLevel",
      "whenPresent": "item"
    },
    "related": [
      {
        "pointer": "/product/eubat:batteryModelIdentifier",
        "relation": "model"
      }
    ]
