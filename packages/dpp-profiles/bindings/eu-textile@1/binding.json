{
  "bindingVersion": "1",
  "id": "eu-textile",
  "version": 1,
  "profile": "eu-textile@1",
  "title": "Textile passport data, serialised item",
  "scope": "The name states which data model the product document uses: a textile passport data model written for Regulation (EU) 2024/1781 and Regulation (EU) No 1007/2011. It makes no claim that a passport or its product complies with those regulations or with any other law.",
  "publisher": {
    "name": "BSV Association",
    "registration": "bundled"
  },
  "source": {
    "name": "OpenEPCIS DPP-Ready",
    "repository": "https://github.com/openepcis/openepcis-dpp-ready",
    "release": "0.13.1",
    "revision": "7a3f28d8869d2e5dd1fb31ace39f538fa04def4e",
    "licence": "Apache-2.0",
    "notices": [
      "NOTICE.md"
    ]
  },
  "granularity": "item",
  "payload": {
    "root": "/product",
    "mediaType": "application/ld+json",
    "documents": "one-self-contained"
  },
  "artefacts": [
    {
      "role": "context",
      "path": "dpp-core-context.jsonld",
      "uri": "https://ref.openepcis.org/extensions/common/core/dpp-core-context.jsonld",
      "mediaType": "application/ld+json",
      "byteLength": 15357,
      "sha256": "96239fd7c8b867f3f15b64931889fa51104357d8edb29a1ac07ae03099673021",
      "licence": "Apache-2.0"
    },
    {
      "role": "context",
      "path": "assessment-context.jsonld",
      "uri": "https://ref.openepcis.org/extensions/common/assessment/assessment-context.jsonld",
      "mediaType": "application/ld+json",
      "byteLength": 4463,
      "sha256": "29f093936b53d91561e5ae07822164b214213fa4833101244131763125f1f6af",
      "licence": "Apache-2.0"
    },
    {
