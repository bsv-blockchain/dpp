      "byteLength": 5547,
      "sha256": "32f98d76207a2b0dafc280c996a7ee60dfb4a51a38060039894eee0f4c4c1d80",
      "licence": "Apache-2.0"
    },
    {
      "role": "context",
      "path": "gs1-shortcuts-context.jsonld",
      "uri": "https://ref.openepcis.org/extensions/common/core/gs1-shortcuts-context.jsonld",
      "mediaType": "application/ld+json",
      "byteLength": 51869,
      "sha256": "d607f9ba803d5d760b9dbec78c531cfa77896963540dd3123c33be46be46da6b",
