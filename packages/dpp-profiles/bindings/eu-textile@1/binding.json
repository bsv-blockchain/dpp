      "sha256": "cedc73cab93ab40dc5cbf3d1e4903bef0c098b0b4d79dba8827c13d21c3ae8c4",
      "licence": "Apache-2.0"
    }
  ],
  "validation": {
    "steps": [
      "json-ld-expand",
      "shacl",
      "passport-identity"
    ],
    "engine": {
      "requires": [
        "shacl-core",
        "shacl-sparql-constraints"
      ]
    },
    "blockingSeverities": [
      "Violation"
    ]
  },
  "identity": {
    "scheme": "gs1-digital-link",
    "comparison": "gs1-key-tuple",
    "subject": {
      "pointers": [
        "/product/id",
        "/product/@id"
      ],
      "keys": [
        "01",
        "21"
      ]
    },
    "mustEqual": [
      {
        "pointer": "/product/gs1:gtin",
        "part": "gtin"
      },
      {
        "pointer": "/product/gs1:hasSerialNumber",
        "part": "serial"
      },
      {
        "pointer": "/product/schema:serialNumber",
        "part": "serial"
      }
    ],
    "mustNotContradict": [
      {
        "pointer": "/product/oec:passportIdentifier"
      },
      {
        "pointer": "/product/gs1:productID"
      }
    ],
    "granularityMember": {
      "pointer": "/product/oec:granularityLevel",
      "whenPresent": "item"
    },
    "related": []
  },
  "vectors": {
    "positive": [
      "vectors/fjordline-aurora-item.jsonld",
      "vectors/garment-product.jsonld"
    ],
    "negative": [
      "vectors/negative-cases.json"
    ]
  },
  "baseline": "native-baseline@2",
  "roles": [
    "passport-writer",
    "passport-reader"
  ]
}
