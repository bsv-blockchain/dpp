      "path": "shapes.ttl",
      "mediaType": "text/turtle",
      "byteLength": 56571,
      "sha256": "85af353af8d89930da31d513c36f4f1c36de0384024d1027dfb6d63b4ea71d77",
      "licence": "Apache-2.0"
    },
    {
      "role": "background",
      "path": "background.ttl",
