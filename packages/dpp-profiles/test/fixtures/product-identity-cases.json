{
  "description": "Thirty-three cases for the product-to-passport identity rules of spec/profiles.md section 7. Every product is invented and every GTIN is under the GS1 demonstration prefix 952. The documents name their products at one host and the passports were minted at another, because the host is never compared. `rules` names the rules each case exercises.",
  "identity": {
    "scheme": "gs1-digital-link",
    "comparison": "gs1-key-tuple",
    "subject": {
      "pointers": [
        "/product/id",
        "/product/@id"
      ],
      "keys": [
        "01",
        "21"
      ]
    },
    "mustEqual": [
      {
        "pointer": "/product/gtin",
        "part": "gtin"
      },
      {
        "pointer": "/product/serialNumber",
        "part": "serial"
      }
    ],
    "mustNotContradict": [
      {
        "pointer": "/product/model"
      }
    ],
    "granularityMember": {
      "pointer": "/product/granularity",
      "whenPresent": "item"
    },
    "related": [
      {
        "pointer": "/product/batch",
        "relation": "batch"
      }
    ]
  },
  "cases": [
    {
      "name": "item document: kettle, identifier, GTIN and serial all stated",
      "rules": [
        2,
        3,
        6
      ],
      "want": "pass",
      "code": "identity-match",
      "passportId": "https://passports.example/01/09521000000018/21/KET-000001",
      "product": {
        "id": "https://id.example/01/09521000000018/21/KET-000001",
        "name": "Kettle",
        "gtin": "09521000000018",
        "serialNumber": "KET-000001"
      }
    },
    {
      "name": "item document: lamp, identifier carries a lot before the serial",
      "rules": [
        2,
        3,
        9
      ],
      "want": "pass",
      "code": "identity-match",
      "passportId": "https://passports.example/01/09521000000025/21/LMP-7731",
      "product": {
        "id": "https://id.example/01/09521000000025/10/LOT7/21/LMP-7731",
        "name": "Lamp",
        "gtin": "09521000000025",
        "serialNumber": "LMP-7731"
      }
    },
    {
      "name": "item document: chair, identifier under the unaliased keyword",
      "rules": [
        2,
        3
