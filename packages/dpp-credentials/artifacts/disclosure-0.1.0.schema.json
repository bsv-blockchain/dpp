{
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": {
        "enum": [
          "https://www.w3.org/ns/credentials/v2",
          "urn:bsv:vsc:context:0.1.0",
          "https://w3id.org/security/suites/ed25519-2020/v1",
          "https://w3id.org/security/data-integrity/v2"
        ]
      },
      "minItems": 2
    },
    "type": {
      "const": [
        "VerifiableCredential",
        "VSC-SEAL"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "issuanceDate": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "validFrom": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "sealVersion": {
      "const": "1.0"
    },
    "sealTimestamp": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "correctionOf": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "predecessorCredentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "credentialStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "type": {
          "const": "BitstringStatusListEntry"
        },
        "statusPurpose": {
          "enum": [
            "revocation",
            "suspension"
          ]
        },
        "statusListIndex": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "statusListCredential": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        }
      },
      "required": [
        "id",
        "type",
        "statusPurpose",
        "statusListIndex",
        "statusListCredential"
      ],
      "additionalProperties": false
    },
    "eventVector": {
      "type": "object",
      "properties": {
        "what": {
          "type": "object",
          "properties": {
            "productIdentifiers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schemeAuthority": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serialNumber": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "scheme",
                  "value",
                  "schemeAuthority"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "classifications": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "minItems": 0
            },
            "batchOrLot": {
              "type": "string",
              "minLength": 1
            },
            "expiryDate": {
              "type": "string",
              "format": "date"
            },
            "quantity": {
              "type": "number",
              "minimum": 0
            },
            "quantityUnit": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "productIdentifiers"
          ],
          "additionalProperties": false,
          "dependencies": {
            "quantity": [
              "quantityUnit"
            ]
          }
        },
        "when": {
          "type": "object",
          "properties": {
            "eventTime": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "recordedAt": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "timePrecision": {
              "enum": [
                "millisecond",
                "second",
                "minute"
              ]
            }
          },
          "required": [
            "eventTime",
            "timezone"
          ],
          "additionalProperties": false
        },
        "where": {
          "type": "object",
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "readPoint": {
              "type": "object"
            },
            "businessLocation": {
              "type": "object"
            },
            "geoCoordinates": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jurisdiction"
          ],
          "additionalProperties": false
        },
        "who": {
          "type": "object",
          "properties": {
            "actorDid": {
              "type": "string",
              "minLength": 1,
              "pattern": "^did:[a-z0-9]+:[^\\s]+$"
            },
            "actorRole": {
              "type": "string",
              "minLength": 1
            },
            "assertionMethod": {
              "type": "string",
              "minLength": 1,
              "pattern": "^did:[a-z0-9]+:[^\\s]+$"
            },
            "actorLicense": {
              "type": "object"
            }
          },
          "required": [
            "actorDid",
            "actorRole",
            "assertionMethod"
          ],
          "additionalProperties": false
        },
        "how": {
          "type": "object",
          "properties": {
            "eventType": {
              "type": "string",
              "minLength": 1
            },
            "eventTypeVocab": {
              "type": "string",
              "minLength": 1,
              "pattern": "^urn:"
            },
            "businessStep": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "enum": [
                "active",
                "in_transit",
                "stored",
                "transshipped",
                "returned",
                "transformed",
                "received",
                "dispensed",
                "destroyed"
              ]
            },
            "action": {
              "enum": [
                "ADD",
                "OBSERVE",
                "DELETE"
              ]
            }
          },
          "required": [
            "eventType",
            "eventTypeVocab",
            "disposition"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "what",
        "when",
        "where",
        "who",
        "how"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {
        "+Dn": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "required": [
        "+Dn"
      ],
      "additionalProperties": false
    },
    "chainOfCustody": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parentSeals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "childSeals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "topology": {
          "enum": [
            "linear",
            "fork",
            "merge",
            "transform",
            "correction"
          ]
        },
        "topologyNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "chainId"
      ],
      "additionalProperties": false
    },
    "proof": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Ed25519Signature2020",
                "DataIntegrityProof"
              ]
            },
            "verificationMethod": {
              "type": "string",
              "minLength": 1,
              "pattern": "^did:[a-z0-9]+:[^\\s]+$"
            },
            "proofPurpose": {
              "const": "assertionMethod"
            },
            "proofValue": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[zu][A-Za-z0-9_-]+$"
            },
            "created": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "cryptosuite": {
              "const": "bbs-2023"
            }
          },
          "required": [
            "type",
            "verificationMethod",
            "proofPurpose",
            "proofValue"
          ],
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Ed25519Signature2020",
                  "DataIntegrityProof"
                ]
              },
              "verificationMethod": {
                "type": "string",
                "minLength": 1,
                "pattern": "^did:[a-z0-9]+:[^\\s]+$"
              },
              "proofPurpose": {
                "const": "assertionMethod"
              },
              "proofValue": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[zu][A-Za-z0-9_-]+$"
              },
              "created": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              },
              "cryptosuite": {
                "const": "bbs-2023"
              }
            },
            "required": [
              "type",
              "verificationMethod",
              "proofPurpose",
              "proofValue"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      ]
    }
  },
  "required": [
    "@context",
    "type",
    "id",
    "issuer",
    "validFrom",
    "sealVersion",
    "sealTimestamp",
    "correctionOf",
    "credentialSubject",
    "credentialStatus",
    "eventVector",
    "chainOfCustody",
    "proof"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:bsv:vsc:schema:0.1.0:disclosure"
}
