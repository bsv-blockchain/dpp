# The scaffold wrote .env from this file with fresh secrets and the default testnet index;
# this copy keeps the placeholders. The npm scripts (dev, start, wallet, operations, go-live) read
# .env at start, as does Docker with --env-file. A value already set in the environment wins over
# the file. Values marked (live) are needed only to write real passports; `npm test` and
# `npm run dev` work without them, and `npm run go-live` fills in what it can.

# The chain your wallet and index are on: test for the default testnet index, main for mainnet
NETWORK=test
PORT=3000
# Where the web app is served from in production (the API serves it); in dev Vite proxies to the API
PUBLIC_URL=http://localhost:3000

# MongoDB for the application's records, journal and sign-in
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=dpp_app

# Sign-in (Better Auth). Generate a secret with: openssl rand -hex 32
AUTH_SECRET=change-me-to-32-random-bytes-hex

# The platform wallet: a BRC-100 wallet the API owns (wallet-toolbox on SQLite).
# Empty until the first `npm run go-live`, which generates the root key here. Keep it secret and backed up.
WALLET_ROOT_KEY=
WALLET_FILE=local/wallet.sqlite
# WhatsOnChain API key: the header source for the wallet and the reader (live)
WOC_API_KEY=
# An ARC-compatible broadcaster URL; empty uses the toolbox's defaults for the network (live)
ARC_URL=

# Secrets the platform derives managed identities from: one per brand, one per recipient. openssl rand -hex 32 each.
BRAND_ROOT_SECRET=
MANAGED_IDENTITY_SECRET=

# The index this app announces passports to and readers look them up in. The default is the
# hosted testnet index (mainnet: https://dpp-overlay.bsvb.net with NETWORK=main). Until
# `npm run go-live` has registered the app's publisher key and stored the two tokens below, the
# API runs an index in this process instead. `npm run connect-index` takes another provider's
# address and tokens, or with --from the connection file an index operator wrote with
# `dpp-index connection`, your own index's included.
INDEX_URL=https://dpp-overlay-testnet.bsvb.net
INDEX_SUBMIT_TOKEN=
INDEX_CALLBACK_TOKEN=
# Only for `npm run export`, which carries the index's own signed evidence for each passport. The token is the
# one the index wants for its complete export, where its operator set one and gave it to you; a passport of up
# to 500 states needs none. The key is the index's exporter identity key, to hold its packages to. Empty uses
# the key the index's capability document names.
INDEX_EXPORT_TOKEN=
INDEX_EXPORTER_KEY=

# The host passports are minted under: https://<PASSPORT_HOST>/01/<gtin>/21/<serial>
PASSPORT_HOST=localhost:3000
# The GS1 company prefix passports may be written under. 952 is GS1's demonstration prefix, never licensed to anyone.
# Replace with your licensed prefix for real products; the demo notice switches off with it.
GS1_PREFIX=952

# Profiles of your own, each held by a binding in a folder: binding.json and the files it names (README,
# Product documents under a binding). Folders are comma-separated, and a relative one is read from this
# file's directory. A folder is registered at start only when the SHA-256 of its binding.json is listed in
# TRUSTED_BINDING_DIGESTS: that is how you say you reviewed that exact file. A folder that is not trusted,
# or that changed since, is refused by name at start and the app runs without it. The two sector profiles
# the DPP packages ship, eu-battery@1 and eu-textile@1, need neither setting.
CUSTOM_PROFILE_DIRS=
TRUSTED_BINDING_DIGESTS=
# Where the bound profiles are read from. Empty reads the two sector profiles from the folder the profiles
# package ships. A folder here is read as a profile bundle instead, and the package's folder is not read:
# `npm run restore` installs the bundle of the package it restores into it. A relative folder is read from
# this file's directory. Trust is the same either way (README, Where the profiles are read from).
PROFILE_BUNDLE_DIR=

# The validation engine for profiles held by a binding. Empty runs the JSON-LD and SHACL libraries in the
# API's own process. An address asks a validator service there instead: the DPP operator preset runs one, and
# `npx dpp-validator` starts one on 127.0.0.1:8090. The token is the one that service requires, if any. It is
# sent to that address only and is never logged. A service that does not answer blocks writes under a bound
# profile and never reads as a pass (README, The validation engine).
VALIDATOR_URL=
VALIDATOR_TOKEN=

# EPCIS exchange: importing EPCIS 2.0 documents, pulling events from a source and exporting what was received.
# Documents are checked against three files GS1 publishes under its own terms, which this project does not
# contain. The API obtains them from https://ref.gs1.org once, at start, into this folder, and checks every
# byte against a pinned digest. A relative folder is read from this file's directory. With OFFLINE=true the API
# never fetches: place the files in the folder yourself (`npx dpp-gs1-artefacts verify --dir <folder>` lists them).
# Without the files the API still starts, and refuses every import and pull by name.
DPP_GS1_ARTEFACTS_DIR=local/gs1
DPP_GS1_ARTEFACTS_OFFLINE=false
# Where the exchange keeps what it retains. mongodb is the application database above, and the store this
# application is built and tested on. file keeps it in EPCIS_STORAGE_DIR through the file-system adapter the
# DPP packages ship: one process, one disk, no replication. It shows the store can be replaced and is not
# offered as a second production database.
EPCIS_STORAGE=mongodb
EPCIS_STORAGE_DIR=local/epcis-store

# The EPCIS query sources this app may pull from: names, comma-separated, each of lower-case letters, digits
# and hyphens. Nothing about a source comes from a request. For a source named supplier-a set, with the name in
# upper case and each hyphen as an underscore:
#   EPCIS_SOURCE_SUPPLIER_A_URL             the base address of its query interface; events are asked for at <URL>/events
#   EPCIS_SOURCE_SUPPLIER_A_ORIGINS         every origin a request may go to, comma-separated; empty permits the URL's own origin only
#   EPCIS_SOURCE_SUPPLIER_A_BEARER_TOKEN    a bearer token, or
#   EPCIS_SOURCE_SUPPLIER_A_BASIC_USER      a user name with
#   EPCIS_SOURCE_SUPPLIER_A_BASIC_PASSWORD  its password, or
#   EPCIS_SOURCE_SUPPLIER_A_HEADER_NAME     the name of a credential header with
#   EPCIS_SOURCE_SUPPLIER_A_HEADER_VALUE    its value
#   EPCIS_SOURCE_SUPPLIER_A_LOCAL_TEST      true permits plain http and private addresses: for a source on your own machine only
#   EPCIS_SOURCE_SUPPLIER_A_REPEAT_LISTS    true sends each value of a list as its own parameter, for a source that needs it
# The credential stays in this file and the API's memory. It is sent to the URL's own origin only, and is never
# written to the database, an answer, a log line or the web app.
EPCIS_SOURCES=

# A registry that validates and stores lifecycle claims (POST /validate is open on the hosted reference)
REGISTRY_URL=https://dpp-resolver.bsvb.net
REGISTRY_TOKEN=

# Writing to the chain spends real satoshis. `npm run go-live` sets this to true once every check passes.
LIVE_PUBLISHING=false
# How many satoshis the platform may spend per day before it refuses to write more
SPEND_CAP_SATOSHIS=20000
