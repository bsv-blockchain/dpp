{
  "name": "api",
  "private": true,
  "description": "The application API: owns the platform wallet, writes and reads passports with the @bsv/dpp packages, keeps the journal and runs the unattended duties",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bsv/dpp-overlay-topics": "0.4.0-beta.11",
    "@bsv/dpp-profiles": "0.3.0-beta.9",
    "@bsv/dpp-protocol": "0.3.0-beta.9",
    "@bsv/overlay": "2.3.1",
    "@bsv/sdk": "2.8.10",
    "@bsv/wallet-toolbox": "2.14.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.7",
    "express": "5.3.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
