{
  "name": "api",
  "private": true,
  "description": "The application API: owns the platform wallet, writes and reads passports with the @bsv/dpp packages, keeps the journal and runs the unattended duties",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bsv/dpp-credentials": "0.2.0-beta.6",
    "@bsv/dpp-overlay": "0.4.0-beta.13",
    "@bsv/dpp-profiles": "0.3.0-beta.10",
    "@bsv/dpp-protocol": "0.3.0-beta.10",
    "@bsv/overlay": "2.8.0",
    "@bsv/sdk": "4.1.2",
    "@bsv/wallet-toolbox": "2.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.27",
    "express": "5.3.0",
    "jsonld": "9.0.0",
    "mongodb": "7.9.1",
    "n3": "2.13.12",
    "shacl-engine": "1.1.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "mongodb-memory-server": "11.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
