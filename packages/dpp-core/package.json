  },
  "dependencies": {
    "@bsv/sdk": "2.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/dpp.git",
    "directory": "packages/dpp-core"
  },
  "publishConfig": {
    "access": "public"
  }
