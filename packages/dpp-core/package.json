{
  "name": "@bsv/dpp-core",
  "version": "0.3.0",
  "description": "DPP Token Standard v1 reference implementation: field encode/decode, canonical signature preimage, verifyChain incl. SPV",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
