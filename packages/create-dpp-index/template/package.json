{
  "name": "my-dpp-index",
  "private": true,
  "type": "module",
  "description": "A standalone DPP index operator project",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "node --test test/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "connection": "node scripts/connection.mjs",
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "logs": "docker compose logs -f index"
  },
  "dependencies": { "@bsv/dpp-overlay-topics": "0.4.0-beta.11" },
  "overrides": { "@bsv/overlay": { "@bsv/sdk": "2.8.10" } }
}
