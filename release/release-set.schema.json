{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsv-blockchain.github.io/dpp/release/release-set.schema.json",
  "title": "DPP compatible release set",
  "description": "One compatible set of the standard's packages, the wire versions they implement, the custody profile the reference selects, the runtime they need and the fixtures and schemas they were tested against. A documentation and conformance selection: nothing here changes a byte, and a changed wire or profile contract is a new identifier, never an edit of a frozen one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseSet",
    "status",
    "baseline",
    "runtime",
    "packages",
    "wire",
    "custody",
    "serviceInterface",
    "artefacts",
    "consumers"
  ],
  "properties": {
    "releaseSet": {
      "type": "string",
      "pattern": "^dpp-release-[0-9]{4}-[0-9]{2}(-[a-z0-9]+)?$"
    },
    "status": {
      "enum": [
        "candidate",
        "released",
        "superseded"
      ]
    },
    "description": {
      "type": "string"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "dependencies"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "directory",
          "entryPoints",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "entryPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "serverOnly": {
            "type": "boolean"
          },
          "nodeBuiltins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^node:[a-z_/]+$"
            },
            "description": "Every Node built-in module the package's built code imports, so a consumer knows what runtime it needs; the checker scans dist/ and refuses a declaration that differs from the code."
          },
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entryPoint",
                "kind",
                "runtime",
                "browser",
                "types"
              ],
              "properties": {
                "entryPoint": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "module",
                    "data"
                  ],
                  "description": "module: code with an exports map entry; data: files served verbatim under a pattern."
                },
                "runtime": {
                  "enum": [
                    "node",
                    "any"
                  ],
                  "description": "node: needs Node 22 or later; any: plain data files any runtime or language reads."
                },
                "browser": {
                  "enum": [
                    "unsupported",
                    "untested",
                    "supported"
                  ],
                  "description": "unsupported: imports Node built-ins or server-only dependencies; untested: nothing known to prevent it, but no browser route is tested or promised; supported: plain data, or a tested browser route exists."
                },
                "types": {
                  "type": "boolean",
                  "description": "Whether TypeScript declarations are shipped for the entry point."
                },
                "sideEffects": {
                  "type": "boolean",
                  "description": "Whether importing the entry point does anything beyond defining exports."
                },
                "carries": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Data artefacts reachable through the entry point, for a data entry point."
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "description": "The support declaration of every entry point the package exports, rendered as the support table in docs/packages/support-table.md and held to the code by the checker."
          }
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "nativeClaim",
        "anchor",
        "acceptanceRecord",
        "verificationReport",
        "overlayContract"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "fieldCount",
              "protocolId",
              "specification"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "fieldCount": {
                "type": "integer"
              },
              "protocolId": {
                "type": "array"
              },
              "specification": {
                "type": "string"
              }
            }
          }
        },
        "nativeClaim": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "acceptanceRecord": {
          "type": "string"
        },
        "verificationReport": {
          "type": "string"
        },
        "overlayContract": {
          "type": "string"
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "profile",
        "specification"
      ],
      "properties": {
        "selected": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "specification": {
          "type": "string"
        },
        "alsoSupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serviceInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "entryPoints",
        "operations"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pins": {
            "type": "string"
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "consumes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "consumes": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dockerfile",
        "preset"
      ],
      "properties": {
        "dockerfile": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "preset",
        "own",
        "thirdParty"
      ],
      "description": "The container images that belong to the set: the ones built from this repository, and the ones the operator preset names that somebody else publishes. The one place the registry, the names and the digests are written; the preset under deploy/ is rendered from it and the checker holds the preset to it. `image` is the earlier form, kept by the sets that predate this member.",
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9][a-z0-9._-]*)*$",
          "description": "The registry host and namespace the set's own images are published under, with no trailing slash. A name until the images are published."
        },
        "preset": {
          "type": "string",
          "description": "The Compose file that runs the images."
        },
        "own": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "service",
              "package",
              "dockerfile",
              "runtime",
              "platforms",
              "digestVariable",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "description": "The image's name under the registry."
              },
              "service": {
                "type": "string",
                "description": "The preset service that runs it."
              },
              "package": {
                "type": "string",
                "description": "The package of this set whose built code the image runs; the image is labelled with that package's version."
              },
              "dockerfile": {
                "type": "string"
              },
              "runtime": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node",
                  "baseImage"
                ],
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "description": "The exact Node version the image runs, which its Dockerfile checks in every stage."
                  },
                  "baseImage": {
                    "type": "string"
                  }
                }
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^linux/[a-z0-9]+$"
                }
              },
              "digestVariable": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*_IMAGE_DIGEST$",
                "description": "The preset variable that carries the digest."
              },
              "digest": {
                "oneOf": [
                  {
                    "const": "unpublished"
                  },
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                ],
                "description": "The digest of the published multi-platform image, or `unpublished` until the image publication workflow has pushed it. Never a tag."
              }
            }
          }
        },
        "thirdParty": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "service",
              "repository",
              "tag",
              "digest",
              "resolvedAt",
              "licence",
              "distribution"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "repository": {
                "type": "string",
                "description": "The image repository as its publisher names it."
              },
              "tag": {
                "type": "string",
                "description": "The exact version tag the digest was resolved from, kept for the reader. The digest is what is pulled."
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The digest of the multi-platform image index the tag named on `resolvedAt`."
              },
              "resolvedAt": {
                "type": "string",
                "format": "date"
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "licence": {
                "type": "string",
                "description": "The licence its publisher distributes it under, as an SPDX identifier where one exists. Not this repository's licence."
              },
              "distribution": {
                "type": "string",
                "description": "How it reaches a deployment."
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "string",
      "pattern": "^conformance/selections/[A-Za-z0-9.-]+\\.json$",
      "description": "The selection under conformance/selections/ that qualifies this set: the claims it requires and the claims it withholds by name. The checker holds the selection to the set and the publication workflow runs its qualification before it writes anything."
    },
    "distTag": {
      "enum": [
        "latest",
        "next"
      ],
      "description": "The npm tag the set publishes under. Before version 1.0 every set publishes to latest; from 1.0, latest carries stable releases only and prereleases publish to next. A set that names none publishes to next."
    }
  }
}
