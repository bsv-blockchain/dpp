{
  "$schema": "https://raw.githubusercontent.com/bsv-blockchain/ts-stack/main/conformance/schema/vector.schema.json",
  "id": "dpp.nativeanchorbinding.v1",
  "name": "Native claim representation and anchor binding",
  "version": "1.0.0",
  "reference_impl": "@bsv/dpp-protocol",
  "parity_class": "required",
  "brc": [
    "BRC-42",
    "BRC-43",
    "BRC-48"
  ],
  "vectors": [
    {
      "id": "canonical-native-claim",
      "description": "The native identifier and the committed bytes both match the signed claim.",
      "input": {
        "locking_script_hex": "",
        "secured_bytes_hex": "",
        "passport_id": "https://dpp.bsvb.net/01/09521000000018/21/V2-0001",
        "checked_at": "2026-09-07T12:00:00Z"
      },
      "expected": {
        "nativeAttestationSignature": {
          "status": "unknown",
          "reasonCode": "no-evidence"
        },
        "anchorSignature": {
          "status": "pass"
        },
        "anchorDigestAndMetadataBinding": {
          "status": "pass"
        },
        "evidenceAvailability": {
          "status": "pass"
        }
      },
      "tags": [
        "happy-path"
      ]
    },
    {
      "id": "generic-identifier-on-native-claim",
      "description": "A valid service signature commits to the native claim using a different identifier.",
      "input": {
        "locking_script_hex": "",
        "secured_bytes_hex": "",
        "passport_id": "https://dpp.bsvb.net/01/09521000000018/21/V2-0001",
        "checked_at": "2026-09-07T12:00:00Z"
      },
      "expected": {
        "nativeAttestationSignature": {
          "status": "unknown",
          "reasonCode": "no-evidence"
        },
        "anchorSignature": {
          "status": "pass"
        },
        "anchorDigestAndMetadataBinding": {
          "status": "fail",
          "reasonCode": "metadata-mismatch"
        },
        "evidenceAvailability": {
          "status": "pass"
        }
      },
      "tags": [
        "error-case"
      ]
    },
    {
      "id": "formatted-json-native-claim",
      "description": "The anchor commits to formatted JSON. The supplied bytes match the digest but are outside the native canonical representation.",
      "input": {
        "locking_script_hex": "",
        "secured_bytes_hex": "",
        "passport_id": "https://dpp.bsvb.net/01/09521000000018/21/V2-0001",
        "checked_at": "2026-09-07T12:00:00Z"
      },
      "expected": {
        "nativeAttestationSignature": {
          "status": "unknown",
          "reasonCode": "no-evidence"
        },
        "anchorSignature": {
          "status": "pass"
        },
        "anchorDigestAndMetadataBinding": {
          "status": "fail",
          "reasonCode": "decode-failed"
        },
        "evidenceAvailability": {
          "status": "pass"
        }
      },
      "tags": [
        "error-case"
      ]
    }
  ]
}
