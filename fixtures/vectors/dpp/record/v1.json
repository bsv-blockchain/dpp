{
  "$schema": "https://raw.githubusercontent.com/bsv-blockchain/ts-stack/main/conformance/schema/vector.schema.json",
  "id": "dpp.record.v1",
  "name": "DPP record model v1: a state to its output and back",
  "brc": [
    "BRC-42",
    "BRC-43",
    "BRC-48"
  ],
  "version": "1.0.0",
  "reference_impl": "dpp-core@0.1.0",
  "parity_class": "required",
  "vectors": [
    {
      "id": "state-to-script",
      "description": "Sign the twelve data fields as actor and as service, then build the fourteen-field locking script. Signatures are ECDSA with RFC 6979 nonces over SHA-256 of the stated preimages, under BRC-42 children for protocol [1, 'dpp token v1'], counterparty anyone (spec record-model.md sections 2 and 5). The private keys are synthetic test keys, published deliberately.",
      "input": {
        "state": {
          "passportId": "https://id.gs1.org/01/09506000134352/21/JERSEY-001",
          "op": "ACTIVATE",
          "timestamp": "2026-06-11T12:00:00Z",
          "ownerIdentityKey": "023c72addb4fdf09af94f0c94d7fe92a386a7e70cf8a1d85916386bb2535c7b1b1",
          "actorIdentityKey": "034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa",
          "actorKeyId": "maker batch 1",
          "eventData": "",
          "payloadPublic": "{\"name\":\"Club Jersey 2026\",\"fibres\":{\"polyester\":82,\"cotton\":18},\"dataCarrier\":\"EXT-UID-0001\"}",
          "payloadOwnerHash": "74f81fe167d99b4cb41d6d0ccda82278caee9f3e2f25d5e5a3936ff3dcec60d0",
          "previousTxid": ""
        },
        "owner_blob_hex": "0102030405",
        "actor_private_key_hex": "1111111111111111111111111111111111111111111111111111111111111111",
        "server_private_key_hex": "2222222222222222222222222222222222222222222222222222222222222222",
        "owner_private_key_hex": "3333333333333333333333333333333333333333333333333333333333333333",
        "locking_key_hex": "034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa",
        "signature_nonce": "rfc6979"
      },
      "expected": {
        "user_preimage_hex": "",
        "user_signature_hex": "3044022072ae57a8066a1d87b5b4eebe32f66f35556ca2725da6bd5d953942b1dae61914022046411f95fd63a65f4e048c0f4e869b1754ed2b7fe1db50bd88f44f5cfa1830d4",
        "server_preimage_hex": "",
        "server_signature_hex": "3044022062e916e4a385fa9c0ec89723bc99f7e0001443b3e85f8ba18f3d2fb7a55b7be502207415a3464f7d87e491bc03e3e3bd3b23b8af583294816cbafa14623019c7ffa6",
        "user_verification_key_hex": "03b130ba68eebda9a1e6cbe9e78adf967d6400894c01ed9b5921e7b2a8dcf14d4f",
        "server_verification_key_hex": "0202a6fab429f1f6630a28898f7e1378697e796dafe26c6bb466bcfd8545c4cd8b",
        "locking_script_hex": ""
      },
      "tags": [
        "happy-path",
        "brc-42",
        "brc-43",
        "brc-48"
      ]
    },
    {
      "id": "script-to-state",
      "description": "Parse the locking script back to the state, re-derive the user verification key from fields 7 and 8 with no secret, and verify the user signature. The server signature verifies under the service's published identity key, which is admission policy and not token validity.",
      "input": {
        "locking_script_hex": "",
        "server_identity_key_hex": "02466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27"
      },
      "expected": {
        "locking_key_hex": "034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa",
        "state": {
          "passportId": "https://id.gs1.org/01/09506000134352/21/JERSEY-001",
          "op": "ACTIVATE",
          "timestamp": "2026-06-11T12:00:00Z",
          "ownerIdentityKey": "023c72addb4fdf09af94f0c94d7fe92a386a7e70cf8a1d85916386bb2535c7b1b1",
          "actorIdentityKey": "034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa",
          "actorKeyId": "maker batch 1",
          "eventData": "",
          "payloadPublic": "{\"name\":\"Club Jersey 2026\",\"fibres\":{\"polyester\":82,\"cotton\":18},\"dataCarrier\":\"EXT-UID-0001\"}",
          "payloadOwnerHash": "74f81fe167d99b4cb41d6d0ccda82278caee9f3e2f25d5e5a3936ff3dcec60d0",
          "previousTxid": ""
        },
        "user_signature_hex": "3044022072ae57a8066a1d87b5b4eebe32f66f35556ca2725da6bd5d953942b1dae61914022046411f95fd63a65f4e048c0f4e869b1754ed2b7fe1db50bd88f44f5cfa1830d4",
        "server_signature_hex": "3044022062e916e4a385fa9c0ec89723bc99f7e0001443b3e85f8ba18f3d2fb7a55b7be502207415a3464f7d87e491bc03e3e3bd3b23b8af583294816cbafa14623019c7ffa6",
        "user_verification_key_hex": "03b130ba68eebda9a1e6cbe9e78adf967d6400894c01ed9b5921e7b2a8dcf14d4f",
        "user_signature_valid": true,
        "server_verification_key_hex": "0202a6fab429f1f6630a28898f7e1378697e796dafe26c6bb466bcfd8545c4cd8b",
        "server_signature_valid": true
      },
      "tags": [
        "happy-path",
        "brc-42",
        "brc-48"
      ]
    },
    {
      "id": "refuse-uncompressed-key",
      "description": "The locking key re-pushed in the 65-byte uncompressed spelling. Refused at the push; the spec requires the compressed encoding.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "locking key push is not 33 bytes"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-tail-short",
      "description": "One OP_2DROP short of the seven the fourteen fields need.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "drop tail is not exactly seven OP_2DROP"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-tail-wrong-opcodes",
      "description": "The right drop total spelled with OP_DROP pairs instead of OP_2DROP.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "drop tail is not exactly seven OP_2DROP"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-tail-trailing-chunk",
      "description": "A trailing chunk after a correct tail.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "drop tail is not exactly seven OP_2DROP"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-rolled-timestamp",
      "description": "Field 5 as 2026-02-30T00:00:00Z, a date the calendar does not contain; hosts that roll it into March accepted it invisibly.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "timestamp is not a real calendar instant"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-mangled-utf8",
      "description": "payload_public as the bytes 22 ff 22: invalid UTF-8 whose lossy decode is valid JSON. Refused at the bytes, not after them.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "field declared UTF-8 does not round-trip"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-nul-passport-id",
      "description": "passport_id pushed non-minimally as the single byte 0x00, which no field may be.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "single byte 0x00 is not a field value"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-empty-pushdata",
      "description": "event_data's OP_0 re-encoded as a zero-length PUSHDATA1; OP_0 is the only accepted encoding of the empty field.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "empty field encoded other than OP_0"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    },
    {
      "id": "refuse-overlong-passport-id",
      "description": "passport_id at 513 bytes, one over the 512-byte bound the spec sets because the field is a BRC-42 key identifier.",
      "input": {
        "locking_script_hex": ""
      },
      "expected": {
        "accepted": false,
        "stage": "decode",
        "reason": "passport_id exceeds 512 bytes"
      },
      "tags": [
        "error-case",
        "brc-48"
      ]
    }
  ]
}
