          "signature": "30440220465d8e07210e89f82ad523bddd3af1040e092541a0b70e6fdd7a023e470265e00220586b84d41fb83a15bcd8f97830b1358d8312a038dcb9de2c2bc25f3e94bace38"
        },
        "expectations": {
          "indexUrl": "https://index.example/",
