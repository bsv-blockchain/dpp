        "error-case"
      ]
    },
    {
      "id": "refuse-other-index",
      "description": "Signed for another index URL: the signature verifies under its own derivation and the index refuses it as not addressed to it.",
      "input": {
        "request": {
          "registrationFormat": "dpp-index-registration@1",
          "indexUrl": "https://other.example/",
