{
  "$schema": "https://raw.githubusercontent.com/bsv-blockchain/ts-stack/main/conformance/schema/vector.schema.json",
  "id": "dpp.indexregistration.v1",
  "name": "DPP index registration request v1: the wallet-signed request an application sends to register its publisher key with an index",
  "brc": [],
  "version": "1.0.0",
  "reference_impl": "dpp-protocol@0.3.0",
  "parity_class": "required",
  "vectors": [
    {
      "id": "sign",
      "description": "Canonicalise the request without its signature (object keys sorted by code point, no whitespace, string values only), sign SHA-256 of those bytes with the BRC-42 child of the publisher key for protocol [1, \"dpp index registration v1\"], key identifier the index URL and counterparty anyone (the BRC-100 createSignature operation).",
      "input": {
        "claim": {
          "registrationFormat": "dpp-index-registration@1",
          "indexUrl": "https://index.example/",
          "publisherKey": "023c72addb4fdf09af94f0c94d7fe92a386a7e70cf8a1d85916386bb2535c7b1b1",
          "network": "test",
          "custodyProfile": "managed-custody@2",
          "label": "Cell pack demo",
          "requestedAt": "2026-11-02T09:58:30Z"
        },
        "publisher_private_key_hex": "3333333333333333333333333333333333333333333333333333333333333333",
        "derivation": {
          "protocol_id": [
            1,
            "dpp index registration v1"
          ],
          "key_id": "https://index.example/",
          "counterparty": "anyone"
        },
        "signature_nonce": "rfc6979"
      },
      "expected": {
        "signing_preimage_hex": "",
        "signature_hex": "30440220143c49f94c5d9e36bcebade931469356e40a6caafb929d30c673f20bed23cfef02207e4f33a3d319c415fd998bcec89ca4944743b24a07e2ad02d21337de86d4cc98",
        "verification_key_hex": "035b576862eb37bc4eec44dc51ec2be2f1750330c47866070c1b18fab7e52d844f"
      },
      "tags": [
        "happy-path"
      ]
    },
    {
      "id": "accept",
      "description": "Verify the request under the child of its own publisherKey and indexUrl, then compare it with what the index expects: its address, network, custody profile and a clock window of ten minutes.",
      "input": {
        "request": {
          "registrationFormat": "dpp-index-registration@1",
          "indexUrl": "https://index.example/",
          "publisherKey": "023c72addb4fdf09af94f0c94d7fe92a386a7e70cf8a1d85916386bb2535c7b1b1",
          "network": "test",
          "custodyProfile": "managed-custody@2",
          "label": "Cell pack demo",
          "requestedAt": "2026-11-02T09:58:30Z",
          "signature": "30440220143c49f94c5d9e36bcebade931469356e40a6caafb929d30c673f20bed23cfef02207e4f33a3d319c415fd998bcec89ca4944743b24a07e2ad02d21337de86d4cc98"
        },
        "expectations": {
          "indexUrl": "https://index.example/",
          "network": "test",
          "custodyProfile": "managed-custody@2",
          "now": "2026-11-02T10:00:00Z",
          "windowMs": 600000
        }
      },
      "expected": {
        "valid": true,
        "reasons": []
      },
      "tags": [
        "happy-path"
      ]
    },
    {
      "id": "refuse-tampered-label",
      "description": "label changed after signing.",
      "input": {
        "request": {
          "registrationFormat": "dpp-index-registration@1",
          "indexUrl": "https://index.example/",
          "publisherKey": "023c72addb4fdf09af94f0c94d7fe92a386a7e70cf8a1d85916386bb2535c7b1b1",
          "network": "test",
          "custodyProfile": "managed-custody@2",
          "label": "Someone else",
          "requestedAt": "2026-11-02T09:58:30Z",
          "signature": "30440220143c49f94c5d9e36bcebade931469356e40a6caafb929d30c673f20bed23cfef02207e4f33a3d319c415fd998bcec89ca4944743b24a07e2ad02d21337de86d4cc98"
        },
        "expectations": {
          "indexUrl": "https://index.example/",
          "network": "test",
          "custodyProfile": "managed-custody@2",
          "now": "2026-11-02T10:00:00Z",
          "windowMs": 600000
        }
      },
      "expected": {
        "valid": false,
        "reasons": [
          "signature-invalid"
        ]
      },
      "tags": [
        "error-case"
      ]
    },
    {
      "id": "refuse-stranger-signed",
      "description": "Signed under the registration protocol from a root other than the publisher key the request names.",
      "input": {
        "request": {
          "registrationFormat": "dpp-index-registration@1",
