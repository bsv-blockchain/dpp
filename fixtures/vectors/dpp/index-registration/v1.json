    {
      "id": "refuse-stale",
      "description": "Well signed, requested twenty minutes before the index clock, outside its ten-minute window.",
      "input": {
        "request": {
          "registrationFormat": "dpp-index-registration@1",
          "indexUrl": "https://index.example/",
