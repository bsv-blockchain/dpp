.DS_Store
# Both spellings on purpose. The trailing slash matches a directory and nothing
# else, so a *symlinked* node_modules is not ignored by it: a git worktree that
# borrows the primary checkout's dependencies gets one, and `git add -A` commits
# an absolute path to somebody's laptop.
node_modules
node_modules/
dist/

# Secrets are environment only, in every workspace.
.env
.env.*
!.env.example

# Private working documents: the BRC proposal draft stays local until the
# standard goes public and the proposal is submitted to bitcoin-sv/BRCs.
brc/

# Filled-in operator env files for deploy/compose.yml stay local.
deploy/*.env

# Packed release candidates and their record are generated by scripts/release-candidates.mjs.
release/candidates/
release/candidates.json

# The implementer bundle and its archive are generated by scripts/implementer-bundle.mjs.
release/implementer-bundle/
release/dpp-implementer-bundle-*.tgz
