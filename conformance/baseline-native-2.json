  "dependencies": [
    {
      "name": "@bsv/sdk",
      "version": "2.8.10",
      "usedBy": [
        "@bsv/dpp-protocol",
        "@bsv/dpp-overlay",
        "examples"
      ]
    },
    {
      "name": "@bsv/overlay",
      "version": "2.3.1",
      "usedBy": [
        "@bsv/dpp-overlay"
      ]
    },
    {
      "name": "mongodb",
      "version": "7.x",
      "usedBy": [
        "@bsv/dpp-overlay (reference persistence, replaceable)"
      ]
    },
    {
      "name": "node",
      "version": ">=22",
      "usedBy": [
        "every workspace package",
        "the index image",
        "CI"
      ]
    }
  ],
  "quickStarts": [
    {
      "role": "passport-reader",
      "command": "node examples/verify-passport.mjs --fixture --version=2 --report",
      "needs": "the fixtures in this repository; no account, wallet, network or other role"
    },
    {
      "role": "attestation-verifier",
      "command": "node examples/verify-attestation-anchor.mjs",
      "needs": "the fixtures in this repository"
    },
    {
      "role": "passport-writer",
      "command": "node examples/lifecycle-v2.mjs",
      "needs": "nothing: fresh keys, no wallet and no network; live, a BRC-100 wallet with funds and an index URL"
    },
    {
      "role": "overlay",
      "command": "docker build -f packages/dpp-overlay/Dockerfile -t dpp-overlay .",
      "needs": "a service identity key; ACCEPTANCE_COMMITMENT=required to declare managed-custody@2; MongoDB for persistence, memory otherwise"
    }
  ]
}
