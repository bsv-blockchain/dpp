    },
    {
      "path": "fixtures/chain-v2.json",
      "sha256": "14e9562e4c8a6ec2cbd85e3eca772e854ccd1e6c5c9322178c4f1bfc1addf4b0",
      "pins": "a five-state version 2 lineage, the control proof in both forms, the acceptance commitment, retirement, twenty-two refusals and the upgrade over the version 1 chain"
    },
    {
