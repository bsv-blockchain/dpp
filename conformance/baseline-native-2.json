{
  "baselineId": "native-baseline@2",
  "version": "2",
  "status": "proposed",
  "description": "The recommended path through the current native formats with record version 2 as the current record and version 1 read beside it, because a lineage may hold both. The same selection as native-baseline@1 for the native claim, the anchor and the report; what is added is the seventeen-field record, its derivation, the managed acceptance record as a representation and the version 2 fixtures. A conformance and documentation selection: nothing here changes a byte, revives a refused format or requires every deployment to fill every role.",
  "wire": {
    "record": {
      "protocolMarker": "dpp",
      "version": "2",
      "fieldCount": 17,
      "specification": "spec/record-model-v2.md",
      "alsoReads": {
        "version": "1",
        "fieldCount": 14,
        "specification": "spec/record-model.md",
        "rule": "A reader selects the version by the field count of the output and reads each state under its own version; a version 1 lineage continues under version 2 only through the upgrade transition of spec/record-model-v2.md section 6."
      }
    },
    "nativeClaim": {
      "claimFormat": "dpp-lifecycle-v1",
      "specification": "spec/rules.md#3-native-signed-claim"
    },
    "anchor": {
      "prefix": "bsv-attestation-anchor-v1",
      "signedFieldCount": 9,
      "dropCount": 5,
      "specification": "spec/rules.md#5-bsv-anchor-v1"
    },
    "verificationReport": {
      "reportVersion": "1",
      "schema": "contracts/verification-report.schema.json",
      "checkNames": [
        "recordEncoding",
        "actorSignatures",
        "publisherSignatures",
        "linkage",
        "inclusion",
        "nativeAttestationSignature",
        "anchorSignature",
        "anchorKeyDerivation",
        "anchorDigestAndMetadataBinding",
        "externalCredentialProof",
        "subjectBinding",
        "issuerAuthority",
        "schema",
        "credentialTime",
        "credentialStatus",
        "evidenceAvailability"
      ]
    }
  },
  "derivations": {
    "userSignature": {
      "protocolId": [
        1,
        "dpp token v1"
      ],
      "keyId": "actor_keyID (field 8)",
      "counterparty": "anyone"
    },
    "serverSignature": {
      "protocolId": [
        1,
        "dpp token v1"
      ],
      "keyId": "passport_id (field 3)",
      "counterparty": "anyone"
    },
    "actorSignatureV2": {
      "protocolId": [
        1,
        "dpp token v2"
      ],
      "keyId": "actor_keyID (field 8)",
      "counterparty": "anyone"
    },
    "publisherSignatureV2": {
      "protocolId": [
        1,
        "dpp token v2"
      ],
      "keyId": "passport_id (field 3)",
      "counterparty": "anyone"
    },
    "ownerKey": {
      "protocolId": [
        1,
        "dpp owner v1"
      ],
      "keyId": "passport_id",
      "counterparty": "self"
    },
    "controllerKey": {
      "protocolId": [
        1,
        "dpp owner v1"
      ],
      "keyId": "passport_id",
      "counterparty": "self"
    },
    "nativeClaimSignature": {
      "protocolId": [
        1,
        "dpp attestation v1"
      ],
      "keyId": "passportId",
      "counterparty": "anyone"
    },
    "anchorSignature": {
      "protocolId": [
        1,
        "bsv attestation anchor v1"
      ],
      "keyId": "attestationId",
      "counterparty": "anyone"
    },
    "managedRecordSignature": {
      "protocolId": [
        1,
        "dpp managed record v1"
      ],
      "keyId": "requestId",
      "counterparty": "anyone"
    }
  },
  "representations": [
    {
      "id": "dpp-lifecycle-json-v1",
      "mediaType": "application/json",
      "bytesHashed": "restricted canonical JSON of the complete signed native claim, including signature",
      "specification": "spec/rules.md#4-secured-representation-bytes"
    },
    {
      "id": "vsc-seal-json-v1",
      "mediaType": "application/vc+ld+json",
      "bytesHashed": "exact UTF-8 bytes of the complete issued credential, including its Data Integrity proof",
      "specification": "spec/vsc-profile.md"
    },
    {
      "id": "dpp-managed-acceptance-v1",
      "mediaType": "application/json",
      "bytesHashed": "canonical JSON (nested, code-unit sorted, no whitespace, strings and safe integers only) of the complete signed acceptance record, including signature; the custodian signs the same form without signature; superseded: signed with the custodian key directly, read under spec/managed-custody.md section 9 and never written",
      "specification": "spec/managed-custody.md#3-the-acceptance-record"
    },
    {
      "id": "dpp-managed-acceptance-v2",
      "mediaType": "application/json",
      "bytesHashed": "canonical JSON (nested, code-unit sorted, no whitespace, strings and safe integers only) of the complete signed acceptance record, including signature; the custodian signs the same form without signature with the managedRecordSignature derivation",
      "specification": "spec/managed-custody.md#3-the-acceptance-record"
    }
  ],
  "refused": [
    "uora-anchor-v2"
  ],
  "historical": [
    "uora-anchor-v1",
    "uora-anchor-v3",
    "tm_uora_dpp",
    "ls_uora_dpp",
    "uora_type"
  ],
  "reasonCodes": "contracts/verification-report.schema.json#/$defs/sharedReasonCode",
  "roles": {
    "passport-reader": {
      "responsibility": "Decode and verify supplied token history of either record version and report the scope of the finding.",
      "requires": [
        "RM-2-script",
        "RM-2-minimal-push",
        "RM-3-fields",
        "RM-4-operations",
        "RM-5-signatures",
        "RM-6-invariants",
        "RM-7-owner-tier",
        "RM-8-verifier",
        "VER-2-report",
        "VER-3-expected-subject",
        "VER-4-checks",
        "VER-5-observations",
        "CONF-2-reader-quickstart",
        "RM2-2-script",
        "RM2-3-fields",
        "RM2-4-operations",
        "RM2-5-signatures",
        "RM2-6-invariants",
        "RM2-6-control-proof",
        "RM2-8-commitment",
        "RM2-9-verifier",
        "VER-4-version-2-findings"
      ],
      "optional": [
        "CUST-4-owner-consent",
        "MC-3-acceptance-record",
        "MC-3-custodian-signing",
        "MC-4-transfer-binding",
        "MC-5-verification-report",
        "MC-9-version-1-records"
      ],
      "testTargets": [
        "fixtures/record-v1.json",
        "fixtures/chain-v1.json",
        "fixtures/evidence-v1.json",
        "examples/verify-passport.mjs --fixture --report",
        "fixtures/record-v2.json",
        "fixtures/chain-v2.json",
        "fixtures/managed-acceptance-v2.json",
        "fixtures/managed-acceptance-v1.json",
        "fixtures/evidence-v2.json",
        "examples/verify-passport.mjs --fixture --version=2 --report"
      ]
    },
    "attestation-verifier": {
      "responsibility": "Verify supplied claim signatures, anchor attribution, digest and metadata binding, and the selected authority and status evidence, reporting what could not be checked.",
      "requires": [
        "RULES-3-native-claim",
        "RULES-4-representation-bytes",
        "RULES-5-anchor",
        "RULES-6-verification",
        "RULES-7-compatibility",
        "VER-2-report",
        "VER-4-checks",
        "ID-2-did-key"
      ],
      "optional": [
        "VSC-2-structure",
        "VSC-3-proofs",
        "VSC-4-status",
        "VSC-4-authority",
        "VSC-5-custody"
      ],
      "testTargets": [
        "fixtures/attestation-anchor-v1.json",
        "fixtures/anchor-v3.json",
        "fixtures/evidence-v1.json",
        "examples/verify-attestation-anchor.mjs"
      ]
    },
    "passport-writer": {
      "responsibility": "Construct valid states and discharge the broadcast, serialisation, announcement, proof and retention duties.",
      "requires": [
        "RM-2-script",
        "RM-3-fields",
        "RM-5-signatures",
        "RM-6-invariants",
        "WR-2-verify-before-send",
        "WR-4-one-writer",
        "WR-5-broadcast",
        "WR-6-announce-retry",
        "WR-7-proof",
        "WR-8-retain",
        "RM2-2-script",
        "RM2-3-fields",
        "RM2-4-operations",
        "RM2-5-signatures",
        "RM2-6-invariants",
        "RM2-6-control-proof",
        "RM2-8-commitment"
      ],
      "optional": [
        "WR-3-announce-before-send",
        "RM-3-gs1-allocation",
        "GS1-check-digit-written",
        "GS1-952-demonstration",
        "MC-3-acceptance-record",
        "MC-3-custodian-signing",
        "MC-4-transfer-binding",
        "MC-4-offer-lifecycle"
      ],
      "testTargets": [
        "examples/write-passport.mjs --dry-run",
        "writer self-report, one sentence per rule (GOVERNANCE.md)",
        "examples/lifecycle-v2.mjs"
      ]
    },
    "attestation-issuer": {
      "responsibility": "Sign attributable lifecycle claims under the declared format and profile, without spending the passport token.",
      "requires": [
        "RULES-3-native-claim",
        "RULES-4-representation-bytes",
        "ID-2-did-key"
      ],
      "optional": [
        "VSC-2-structure",
        "VSC-3-proofs"
      ],
      "testTargets": [
        "fixtures/attestation-anchor-v1.json"
      ]
    },
    "registry": {
      "responsibility": "Apply declared intake and status policies; retain and return exact secured bytes and scoped verification reports.",
      "requires": [
        "SVC-3-registry-bytes",
        "RULES-4-representation-bytes",
        "RULES-5-anchor",
        "RULES-6-verification",
        "STATUS-validate-algorithm",
        "REG-contract-routes",
        "VER-2-report"
      ],
      "optional": [
        "VSC-4-status",
        "VSC-4-authority",
        "VSC-5-custody",
        "SVC-3-legacy-intake"
      ],
      "testTargets": [
        "contracts/registry.yaml",
        "fixtures/attestation-anchor-v1.json"
      ]
    },
    "overlay": {
      "responsibility": "Admit and serve evidence under published policy, including the selected synchronisation profile.",
      "requires": [
        "SVC-2-passport-admission",
        "SVC-2-anchor-admission",
        "SVC-2-cursor-lookup",
        "SVC-2-proof-ingest",
        "SVC-6-idempotent-admission",
        "OVL-contract-must",
        "SVC-2-version-2-admission"
      ],
      "optional": [
        "SVC-1-discovery-sync",
        "CONF-4-overlay-capabilities",
        "CUST-4-owner-consent",
        "MC-7-declaration"
      ],
      "testTargets": [
        "contracts/overlay.yaml",
        "fixtures/attestation-anchor-v1.json",
        "fixtures/vectors/",
        "fixtures/chain-v2.json"
      ]
    }
  },
