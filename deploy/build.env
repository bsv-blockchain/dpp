# Read after the operator's env file by the build-from-source commands only
# (deploy/README.md, Build from source). It holds no secret and is the one
# env file in this directory that is committed.
#
# deploy/compose.yml requires a digest for each image. A build from source
# has none, so these two words stand in for them, and the build file given
# on the same command line replaces the references they would form. They are
# not digests: without the build file Docker refuses the reference, so the
# pinned preset cannot be started from this file.
OVERLAY_IMAGE_DIGEST=built-from-source
VALIDATOR_IMAGE_DIGEST=built-from-source
