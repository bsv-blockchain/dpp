# One operator of the reference index, for deploy/compose.yml. Copy to
# deploy/operator.env, fill in, never commit the copy. Every name is documented
# in packages/dpp-overlay/README.md under Configuration.

# The port published on the host, on every interface. 127.0.0.1:8080 publishes
# it on loopback only, for a TLS proxy on the same host.
OVERLAY_PORT=8080
# The image tag compose builds and runs.
OVERLAY_IMAGE=dpp-overlay:local
MONGO_DB=dpp
# Empty uses the bundled MongoDB, reachable only on the Compose network. A
# managed database's authenticated URI, with TLS, replaces it.
MONGO_URL=
# The application wallet's network, main or test.
NETWORK=main

# The service identity the publisher signature of every admitted state is
# verified against: the PUBLIC key, 66 hex characters, which a generated
# application prints with `npm run wallet` (its first run generates the
# application's wallet root key). Leave SERVER_PRIVATE_KEY empty; the node
# only ever needs the public half.
SERVICE_IDENTITY_KEY=
SERVER_PRIVATE_KEY=

# Write access is per publisher. Tokens bound to one key and one use live in
# this preset's MongoDB; until one is issued every write is refused. Issue an
# application's pair and its connection file after startup with
# `docker compose ... exec -T overlay node packages/dpp-overlay/dist/cli.js connection > deploy/app.env`,
# or one token at a time with `... cli.js tokens issue --publisher <key> --use submit`
# (and --use callback). PUBLISHER_TOKENS_FILE names a file inside the container
# instead, for an operator who mounts one; leave it empty here.
PUBLISHER_TOKENS_FILE=
# Optional operator-wide tokens, accepted for any publisher beside the
# per-publisher ones: the bearer for /submit and /retract, and the token an
# ARC-compatible gateway presents on /arc-ingest. Everyone given one shares it.
SUBMIT_TOKEN=
ARC_CALLBACK_TOKEN=

# Self-service registration (packages/dpp-overlay/README.md, registration): open or approval lets
# an application register its publisher key through POST /register, appending a
# policy version signed by OPERATOR_SIGNING_KEY. Needs PUBLISHER_POLICY_FILE,
# OPERATOR_IDENTITY_KEYS and PUBLIC_URL; leave both empty on an index that
# admits one configured key.
REGISTRATION=
OPERATOR_SIGNING_KEY=
REGISTRATION_RATE_LIMIT=
TRUST_PROXY=

# Leave empty for the header source on NETWORK (WhatsOnChain). scripts-only is
# a local fixture setting: it admits unproven ancestry and claims no inclusion.
CHAIN_TRACKER=
WOC_API_KEY=

# Managed custody (spec/managed-custody.md): required selects the profile, so
# a version 2 TRANSFER is admitted only with its acceptance commitment.
# CONTROL_AUTHORITIES names identity keys whose version 2 states pass the
# control proof by name, for recovery; empty names none, and the application
# must name the same keys. OWNER_CONSENT, TRANSFER_AUTHORITIES and
# INSTRUCTION_COMMITMENT are no longer read, and the node refuses to boot with
# any of them set.
ACCEPTANCE_COMMITMENT=required
CONTROL_AUTHORITIES=

# Anchoring services this node carries anchors for; empty carries every
# treasury's. Name the application's publisher key to carry only its anchors.
ANCHOR_SERVICE_KEYS=

# A publisher policy chain under ./deploy/config, mounted read-only at /config,
# or the same chain inline as JSON where a file cannot be mounted; not both.
PUBLISHER_POLICY_FILE=
PUBLISHER_POLICY_JSON=
OPERATOR_IDENTITY_KEYS=

# The exporter's identity private key, a key of its own and never the
# publisher key. Its BRC-42 child for each passport signs that passport's
# evidence packages (spec/portable-evidence.md section 2), and the capability
# document names its public key as exporterIdentityKey. Empty leaves
# GET /evidence-package and GET /evidence-export answering 503.
# EXPORT_SIGNING_KEY, which an earlier release signed with directly, is no
# longer read, and the node refuses to boot with it set: move its value here
# to keep the exporter identity readers hold, and keep publishing its public
# half for readers checking packages it signed.
EXPORTER_PRIVATE_KEY=
# The bearer for GET /evidence-export, the complete export. Required on any
# reachable deployment that sets EXPORTER_PRIVATE_KEY: empty serves the complete
# export to anyone, one bounded part per request. The bounded
# GET /evidence-package and GET /history stay open either way.
EXPORT_TOKEN=

# This node's own address as applications and other indexes reach it, the
# https origin behind a TLS proxy. dpp-index connection writes it as the
# application's INDEX_URL unless given --url.
PUBLIC_URL=

# Peer synchronisation, off when empty; SYNC_DISCOVERY=ship adds the hosts
# SHIP adverts name.
SYNC_PEERS=
SYNC_INTERVAL_MS=
SYNC_LEGACY=
SYNC_DISCOVERY=
SLAP_TRACKERS=
SYNC_MAX_DISCOVERED=

# SHIP/SLAP advertising, off when empty. ADVERTISE=1 spends from a separate
# advertiser wallet and needs an https PUBLIC_URL.
ADVERTISE=
ADVERTISER_PRIVATE_KEY=
ADVERTISER_STORAGE_URL=
