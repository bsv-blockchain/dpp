# One operator of the reference index, for deploy/compose.yml. Copy to
# deploy/operator.env, fill in, never commit the copy. Every name is documented
# in packages/overlay-topics/README.md under Configuration.

# The port published on the host.
OVERLAY_PORT=8080
# The image tag compose builds and runs.
OVERLAY_IMAGE=dpp-overlay:local
MONGO_DB=dpp
NETWORK=main

# The service identity the publisher signature of every admitted state is
# verified against: the PUBLIC key, 66 hex characters. Leave SERVER_PRIVATE_KEY
# empty; the node only ever needs the public half.
SERVICE_IDENTITY_KEY=
SERVER_PRIVATE_KEY=

# Required on any reachable deployment: the bearer for /submit and /retract,
# and the token an ARC-compatible gateway presents on /arc-ingest.
SUBMIT_TOKEN=
ARC_CALLBACK_TOKEN=

# Leave empty for the header source on NETWORK (WhatsOnChain). scripts-only is
# a local fixture setting: it admits unproven ancestry and claims no inclusion.
CHAIN_TRACKER=
WOC_API_KEY=

# Managed custody (spec/managed-custody.md): required selects the profile, so
# a version 2 TRANSFER is admitted only with its acceptance commitment.
# CONTROL_AUTHORITIES names identity keys whose version 2 states pass the
# control proof by name; the application must name the same keys.
ACCEPTANCE_COMMITMENT=required
CONTROL_AUTHORITIES=

# Version 1 custody profile, optional (spec/custody.md section 4).
OWNER_CONSENT=
TRANSFER_AUTHORITIES=

# Anchoring services this node carries anchors for; empty carries every treasury's.
ANCHOR_SERVICE_KEYS=

# A publisher policy chain under ./deploy/config, mounted read-only at /config.
PUBLISHER_POLICY_FILE=
OPERATOR_IDENTITY_KEYS=

# The private key that signs evidence packages, a key of its own and never the
# publisher key. Empty leaves GET /evidence-package answering 503.
EXPORT_SIGNING_KEY=

# Peer synchronisation, off when empty.
SYNC_PEERS=
SYNC_INTERVAL_MS=
SYNC_LEGACY=
PUBLIC_URL=
