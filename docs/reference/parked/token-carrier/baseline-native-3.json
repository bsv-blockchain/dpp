{
  "baselineId": "native-baseline@3",
  "version": "3",
  "status": "proposed",
  "description": "The recommended path through the current native formats with the carried record version 3 as the current record and versions 1 and 2 read beside it, because a lineage may hold either earlier version and a carried lineage holds version 3 alone. The same selection as native-baseline@2 for the native claim, the anchor, the report and the managed acceptance record; what is added is the BRC-162 token prefix in front of the seventeen-field body, the token id every later state carries, the version 3 derivation and the version 3 fixtures. A conformance and documentation selection: nothing here changes a byte of an earlier version, revives a refused format or requires every deployment to fill every role.",
  "wire": {
    "record": {
      "protocolMarker": "dpp",
      "version": "3",
      "fieldCount": 17,
      "specification": "spec/token-carrier.md",
      "carrier": {
        "prefixDeploy": "OP_0 OP_1 OP_2DROP",
        "prefixValue": "<32-byte token id> OP_1 OP_2DROP",
        "tokenIdBytes": 32,
        "amount": 1,
        "deployOutputIndex": 0,
        "specification": "spec/token-carrier.md#3-the-prefix"
      },
      "alsoReads": [
        {
          "version": "2",
          "fieldCount": 17,
          "specification": "spec/record-model-v2.md",
          "rule": "A bare seventeen-field body is version 2 and one behind a token prefix is version 3; a reader selects the version by the prefix and the field count and reads each state under its own version; no version crosses into or out of a carried lineage (spec/token-carrier.md section 6)."
        },
        {
          "version": "1",
          "fieldCount": 14,
          "specification": "spec/record-model.md",
          "rule": "A fourteen-field body is version 1; a version 1 lineage continues under version 2 only through the upgrade transition of spec/record-model-v2.md section 6, and never into a carried lineage."
        }
      ]
    },
    "nativeClaim": {
      "claimFormat": "dpp-lifecycle-v1",
      "specification": "spec/rules.md#3-native-signed-claim"
    },
    "anchor": {
      "prefix": "bsv-attestation-anchor-v1",
      "signedFieldCount": 9,
      "dropCount": 5,
      "specification": "spec/rules.md#5-bsv-anchor-v1"
    },
    "verificationReport": {
      "reportVersion": "1",
      "schema": "contracts/verification-report.schema.json",
      "checkNames": [
        "recordEncoding",
        "actorSignatures",
        "publisherSignatures",
        "linkage",
        "inclusion",
        "nativeAttestationSignature",
        "anchorSignature",
        "anchorKeyDerivation",
        "anchorDigestAndMetadataBinding",
        "externalCredentialProof",
        "subjectBinding",
        "issuerAuthority",
        "schema",
        "credentialTime",
        "credentialStatus",
        "evidenceAvailability"
      ]
    }
  },
  "derivations": {
    "userSignature": {
      "protocolId": [
        1,
        "dpp token v1"
      ],
      "keyId": "actor_keyID (field 8)",
      "counterparty": "anyone"
    },
    "serverSignature": {
      "protocolId": [
        1,
        "dpp token v1"
      ],
      "keyId": "passport_id (field 3)",
      "counterparty": "anyone"
    },
    "actorSignatureV2": {
      "protocolId": [
        1,
        "dpp token v2"
      ],
      "keyId": "actor_keyID (field 8)",
      "counterparty": "anyone"
    },
    "publisherSignatureV2": {
      "protocolId": [
        1,
        "dpp token v2"
      ],
      "keyId": "passport_id (field 3)",
      "counterparty": "anyone"
    },
    "actorSignatureV3": {
      "protocolId": [
        1,
        "dpp token v3"
      ],
      "keyId": "actor_keyID (field 8)",
      "counterparty": "anyone"
    },
    "publisherSignatureV3": {
      "protocolId": [
        1,
        "dpp token v3"
      ],
      "keyId": "passport_id (field 3)",
      "counterparty": "anyone"
    },
    "ownerKey": {
      "protocolId": [
        1,
        "dpp owner v1"
      ],
      "keyId": "passport_id",
      "counterparty": "self"
    },
    "controllerKey": {
      "protocolId": [
        1,
        "dpp owner v1"
      ],
      "keyId": "passport_id",
      "counterparty": "self"
    },
    "nativeClaimSignature": {
      "protocolId": [
        1,
        "dpp attestation v1"
      ],
      "keyId": "passportId",
      "counterparty": "anyone"
    },
    "anchorSignature": {
      "protocolId": [
        1,
        "bsv attestation anchor v1"
      ],
      "keyId": "attestationId",
      "counterparty": "anyone"
    },
    "managedRecordSignature": {
      "protocolId": [
        1,
        "dpp managed record v1"
      ],
      "keyId": "requestId",
      "counterparty": "anyone"
    }
  },
  "representations": [
    {
      "id": "dpp-lifecycle-json-v1",
      "mediaType": "application/json",
      "bytesHashed": "restricted canonical JSON of the complete signed native claim, including signature",
      "specification": "spec/rules.md#4-secured-representation-bytes"
    },
    {
      "id": "vsc-seal-json-v1",
      "mediaType": "application/vc+ld+json",
      "bytesHashed": "exact UTF-8 bytes of the complete issued credential, including its Data Integrity proof",
      "specification": "spec/vsc-profile.md"
    },
    {
      "id": "dpp-managed-acceptance-v1",
      "mediaType": "application/json",
      "bytesHashed": "canonical JSON (nested, code-unit sorted, no whitespace, strings and safe integers only) of the complete signed acceptance record, including signature; the custodian signs the same form without signature; superseded: signed with the custodian key directly, read under spec/managed-custody.md section 9 and never written",
      "specification": "spec/managed-custody.md#3-the-acceptance-record"
    },
    {
      "id": "dpp-managed-acceptance-v2",
      "mediaType": "application/json",
      "bytesHashed": "canonical JSON (nested, code-unit sorted, no whitespace, strings and safe integers only) of the complete signed acceptance record, including signature; the custodian signs the same form without signature with the managedRecordSignature derivation",
      "specification": "spec/managed-custody.md#3-the-acceptance-record"
    }
  ],
  "refused": [
