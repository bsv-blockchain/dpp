{
  "name": "dpp",
  "private": true,
  "description": "Digital Product Passport standard: specification, reference implementation, conformance fixtures",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @bsv/dpp-protocol -w @bsv/dpp-core -w @bsv/dpp-profiles -w @bsv/dpp-overlay-topics -w @bsv/vsc -w @bsv/create-dpp-index -w @bsv/create-dpp-app",
    "test": "npm run test --workspaces --if-present && npm run conformance:test && npm run conformance:check && npm run docs:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "conformance:check": "node conformance/check.mjs",
    "conformance:test": "node --test conformance/test/*.test.mjs",
    "conformance:qualify": "node conformance/qualify.mjs",
    "conformance:pin": "node conformance/pin-sources.mjs",
    "conformance:independent": "python3 conformance/independent/python/dpp_verify.py",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:render": "node scripts/render-support-table.mjs",
    "release:candidates": "node scripts/release-candidates.mjs",
    "release:consumer": "node scripts/consumer-check.mjs",
    "release:registry": "node scripts/consumer-check.mjs --registry",
    "release:publish": "node scripts/publish-candidates.mjs",
    "release:bundle": "node scripts/implementer-bundle.mjs",
    "starter:check": "node packages/create-dpp-app/scripts/scaffold-check.mjs",
    "index-starter:check": "npm run scaffold:check -w @bsv/create-dpp-index --",
    "index-starter:release": "node scripts/index-starter-release.mjs"
  },
  "overrides": {
    "@bsv/overlay": {
      "@bsv/sdk": "2.8.10"
    }
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
