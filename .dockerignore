# Docker build context: an allowlist. The only image built from here is
# packages/overlay-topics/Dockerfile, whose context is the repository root
# because the service depends on the workspace packages. Everything is
# excluded unless the Dockerfile copies it, so no local working material,
# specification, fixture or documentation can enter the context by accident.
*
!package.json
!package-lock.json
!LICENSE
!tsconfig.base.json
!packages/
!scripts/
scripts/*
!scripts/package-schemas.mjs
!contracts/
contracts/*
!contracts/*.schema.json

# Reinstalled and rebuilt inside the image, never copied.
**/node_modules/
**/dist/
packages/dpp-core/schemas/

# Secrets never enter an image; configuration is environment only.
**/.env
**/.env.*
